---
interface Props {
    project: {
        title: string;
        subtitle: string;
        description: string[];
        location: string;
        area: string;
        year: string;
        status?: string;
    };
}

const { project } = Astro.props;
const completed = project.status === "Completed";
const [first, ...rest] = project.description;
---

<section class="sec overview">
    <div class="wrap ov-grid">

        <aside class="ov-side">
            <div class="ov-sticky" data-reveal>
                <span class="label">Project Overview</span>
                <h2>{project.title}</h2>
                <ul class="ov-details">
                    <li><span>Location</span><strong>{project.location}</strong></li>
                    <li><span>Built Up Area</span><strong>{project.area}</strong></li>
                    <li>
                        <span>Status</span>
                        <strong class:list={["status", completed ? "completed" : "construction"]}>{project.status}</strong>
                    </li>
                    <li>
                        <span>{completed ? "Completed" : "Expected Completion"}</span>
                        <strong>{project.year}</strong>
                    </li>
                    <li><span>Services</span><strong>{project.subtitle}</strong></li>
                </ul>
            </div>
        </aside>

        <div class="ov-content">
            {first && <p class="ov-lead" data-reveal>{first}</p>}
            {rest.map((paragraph) => <p data-reveal>{paragraph}</p>)}
        </div>

    </div>
</section>

<style>
    .ov-grid {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: var(--gap);
        row-gap: 56px;
        align-items: start;
    }
    .ov-side { grid-column: 1 / span 4; align-self: stretch; }
    .ov-sticky { position: sticky; top: calc(var(--header-h) + 32px); }
    .ov-side h2 { margin: 20px 0 36px; font-size: clamp(1.8rem, 1.4rem + 1.4vw, 2.6rem); }

    .ov-details { border-top: 1px solid var(--line); }
    .ov-details li {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 20px;
        padding: 15px 0;
        border-bottom: 1px solid var(--line);
        font-size: var(--fs-small);
    }
    .ov-details span { color: var(--muted); }
    .ov-details strong { color: var(--ink); font-weight: 500; text-align: right; }
    .status { display: inline-flex; align-items: center; gap: 8px; }
    .status::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
    .status.completed::before { background: #4f7a52; }
    .status.construction::before { background: var(--accent); }

    .ov-content { grid-column: 6 / -1; display: grid; gap: 24px; max-width: 70ch; }
    .ov-content p { font-size: 1.02rem; line-height: 1.85; }
    .ov-content .ov-lead {
        font-size: clamp(1.3rem, 1.05rem + .9vw, 1.85rem);
        font-weight: 300;
        line-height: 1.45;
        letter-spacing: -.015em;
        color: var(--ink);
        margin-bottom: 16px;
    }

    @media (max-width: 899px) {
        .ov-side, .ov-content { grid-column: 1 / -1; }
        .ov-sticky { position: static; }
    }
</style>
