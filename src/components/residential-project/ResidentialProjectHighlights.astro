---
interface Props {
    project: {
        area: string;
        year: string;
        location: string;
        services: string;
    };
}

const { project } = Astro.props;

const highlights = [
    { title: "Location", value: project.location },
    { title: "Built Up Area", value: project.area },
    { title: "Completion", value: project.year },
    { title: "Scope", value: project.services },
];
---

<section class="sec--tight sec--white glance">
    <div class="wrap">
        <div class="gl-head" data-reveal>
            <span class="label">Project Information</span>
            <h2>At a Glance</h2>
        </div>
        <dl class="gl-grid" data-reveal-stagger=".08">
            {highlights.map((item, i) => (
                <div class="gl-item" data-reveal>
                    <dt><span>{String(i + 1).padStart(2, "0")}</span>{item.title}</dt>
                    <dd>{item.value}</dd>
                </div>
            ))}
        </dl>
    </div>
</section>

<style>
    .glance { padding-block: var(--space-sm); }
    .gl-head { display: flex; align-items: baseline; justify-content: space-between; gap: 24px; margin-bottom: 32px; }
    .gl-head h2 { font-size: var(--fs-h3); font-weight: 300; }
    .gl-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--line-strong); }
    .gl-item { padding: 24px 24px 0 0; }
    .gl-item + .gl-item { padding-left: 24px; border-left: 1px solid var(--line); }
    .gl-item dt {
        display: flex;
        gap: 12px;
        font-size: var(--fs-label);
        font-weight: 600;
        letter-spacing: .18em;
        text-transform: uppercase;
        color: var(--muted);
    }
    .gl-item dt span { color: var(--ink); letter-spacing: .1em; }
    .gl-item dd { margin-top: 18px; font-size: var(--fs-h4); color: var(--ink); line-height: 1.4; }

    @media (max-width: 899px) {
        .gl-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .gl-item:nth-child(odd) { padding-left: 0; border-left: 0; }
        .gl-item { padding-bottom: 24px; }
        .gl-item:nth-child(n + 3) { border-top: 1px solid var(--line); }
    }
</style>
