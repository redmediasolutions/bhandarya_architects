---
interface Download {
    title: string;
    description?: string;
    type: string;
    size?: string;
    file: string;
}

interface Props {
    downloads: Download[];
}

const { downloads = [] } = Astro.props;
---

{downloads.length > 0 && (
    <section class="sec sec--alt downloads">
        <div class="wrap dl-grid">
            <div class="dl-head" data-reveal>
                <span class="label">Project Documentation</span>
                <h2>Available Downloads</h2>
                <p>
                    Explore architectural drawings, presentation sheets and
                    supporting project documents available for this residence.
                </p>
            </div>

            <ul class="dl-list">
                {downloads.map((item) => (
                    <li data-reveal>
                        <a href={item.file} class="dl-row" download target="_blank" rel="noopener">
                            {item.type && <span class="dl-type label">{item.type}</span>}
                            <span class="dl-main">
                                <h3>{item.title}</h3>
                                {item.description && <p>{item.description}</p>}
                            </span>
                            <span class="dl-foot">
                                {item.size && <span class="dl-size">{item.size}</span>}
                                <strong class="arrow-link"><span>Download</span><span class="ar" aria-hidden="true"></span></strong>
                            </span>
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    </section>
)}

<style>
    .dl-grid {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: var(--gap);
        row-gap: 48px;
    }
    .dl-head { grid-column: 1 / span 4; display: grid; gap: 20px; align-content: start; }
    .dl-head h2 { font-size: clamp(1.8rem, 1.4rem + 1.4vw, 2.6rem); }
    .dl-head p { max-width: 40ch; }
    .dl-list { grid-column: 6 / -1; border-top: 1px solid var(--line-strong); }
    .dl-list li { border-bottom: 1px solid var(--line); }
    .dl-row {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 24px;
        padding: 26px 0;
        transition: padding .5s var(--ease);
    }
    .dl-row:hover { padding-left: 12px; }
    .dl-main h3 { font-size: var(--fs-h4); font-weight: 450; }
    .dl-main p { margin-top: 4px; font-size: var(--fs-small); color: var(--muted); }
    .dl-foot { display: flex; align-items: center; gap: 24px; }
    .dl-size { font-size: var(--fs-small); color: var(--muted); }
    .dl-type:empty { display: none; }

    @media (max-width: 899px) {
        .dl-head, .dl-list { grid-column: 1 / -1; }
        .dl-row { grid-template-columns: 1fr; gap: 12px; }
    }
</style>
