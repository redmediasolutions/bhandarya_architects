---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import SectionHead from "../ui/SectionHead.astro";

interface Props {
    title?: string;
    images: ImageMetadata[];
}

const { title = "Project Gallery", images = [] } = Astro.props;

/* rhythm: one full-bleed frame, then a pair — repeated */
const sizeFor = (i: number) => (i % 3 === 0 ? "full" : "half");
---

<section class="sec gallery">
    <div class="wrap">
        <SectionHead
            label="Completed Project"
            title={title}
            intro="A collection of completed spaces capturing the architecture, interiors and craftsmanship of the residence."
        />

        <div class="gal-grid pswp-gallery" data-gallery>
            {images.map((image, index) => {
                const size = sizeFor(index);
                return (
                    <a
                        href={image.src}
                        class:list={["gal-item", `gal-${size}`]}
                        data-pswp-width={image.width}
                        data-pswp-height={image.height}
                        data-reveal
                    >
                        <div class="media">
                            <Image
                                src={image}
                                width={Math.min(size === "full" ? 2000 : 1200, image.width)}
                                alt={`${title} ${index + 1}`}
                                loading="lazy"
                                decoding="async"
                            />
                        </div>
                        <span class="gal-cap">
                            <span class="gal-n">{String(index + 1).padStart(2, "0")}</span>
                            <span class="gal-view">View Image</span>
                        </span>
                    </a>
                );
            })}
        </div>
    </div>
</section>

<script>
    import "../../scripts/lightbox";
</script>

<style>
    .gal-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: clamp(32px, 4vw, 64px) var(--gap);
    }
    .gal-full { grid-column: 1 / -1; }
    .gal-full .media { aspect-ratio: 16 / 9; }
    .gal-half .media { aspect-ratio: 4 / 3; }
    .gal-item { display: block; cursor: zoom-in; }

    .gal-cap {
        display: flex;
        justify-content: space-between;
        padding-top: 12px;
        font-size: var(--fs-label);
        font-weight: 600;
        letter-spacing: .16em;
        text-transform: uppercase;
        color: var(--muted);
    }
    .gal-view { opacity: 0; transform: translateX(-6px); transition: opacity .4s ease, transform .4s var(--ease); color: var(--ink); }
    .gal-item:hover .gal-view { opacity: 1; transform: none; }
    @media (hover: none) { .gal-view { opacity: 1; transform: none; } }

    @media (max-width: 699px) {
        .gal-grid { grid-template-columns: 1fr; }
        .gal-full .media, .gal-half .media { aspect-ratio: 4 / 3; }
    }
</style>
