---
import projects from "../../content/residential";
import { getResidentialImages } from "../../lib/residentialImages";
import SectionHead from "../ui/SectionHead.astro";
import ProjectCard from "../ui/ProjectCard.astro";

interface Props {
    project: any;
}

const { project } = Astro.props;

const relatedProjects = projects.filter((p) => (project.related ?? []).includes(p.slug));
---

{relatedProjects.length > 0 && (
    <section class="sec sec--white related">
        <div class="wrap">
            <SectionHead
                label="More Projects"
                title="Continue Exploring"
                intro="Discover more projects crafted with the same attention to detail, timeless design and thoughtful planning."
            />

            <div class="rel-grid">
                {relatedProjects.map((item) => (
                    <ProjectCard
                        href={`/projects/residences/${item.slug}`}
                        image={getResidentialImages(item.folder).hero}
                        title={item.title}
                        eyebrow={item.location}
                        cta="Explore Project"
                        ratio="ratio-4-3"
                        width={1100}
                    />
                ))}
            </div>
        </div>
    </section>
)}

<style>
    .rel-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 56px var(--gap);
    }
    @media (max-width: 1024px) { .rel-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 599px) { .rel-grid { grid-template-columns: 1fr; } }
</style>
