---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import SectionHead from "../ui/SectionHead.astro";

interface Props {
    title?: string;
    images: ImageMetadata[];
}

const { title = "Construction Journey", images = [] } = Astro.props;
---

<section class="sec sec--dark construction">
    <div class="wrap">
        <SectionHead
            label="Behind The Build"
            title={title}
            intro="Every completed residence is the result of months of craftsmanship, coordination and careful execution. These images capture the process behind the finished home."
        />
    </div>

    <div class="cg-track pswp-gallery" data-gallery tabindex="0" aria-label="Construction images">
        {images.map((image, index) => (
            <a
                href={image.src}
                class="cg-item"
                data-pswp-width={image.width}
                data-pswp-height={image.height}
            >
                <div class="media">
                    <Image src={image} width={Math.min(1000, image.width)} alt={`Construction ${index + 1}`} loading="lazy" decoding="async" />
                </div>
                <span class="cg-cap">
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    <span class="cg-view">View Image</span>
                </span>
            </a>
        ))}
    </div>
</section>

<script>
    import "../../scripts/lightbox";
</script>

<style>
    .cg-track {
        display: flex;
        gap: var(--gap);
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        padding-inline: max(var(--gutter), calc((100vw - var(--wrap)) / 2 + var(--gutter)));
        padding-bottom: 24px;
        scrollbar-width: thin;
        scrollbar-color: rgba(255,255,255,.3) transparent;
        outline: none;
    }
    .cg-item {
        flex: 0 0 clamp(260px, 32vw, 460px);
        scroll-snap-align: start;
        cursor: zoom-in;
    }
    .cg-item .media { aspect-ratio: 3 / 4; background: #1d1d1c; }
    .cg-cap {
        display: flex;
        justify-content: space-between;
        padding-top: 12px;
        font-size: var(--fs-label);
        font-weight: 600;
        letter-spacing: .16em;
        text-transform: uppercase;
        color: rgba(255,255,255,.5);
    }
    .cg-view { color: #fff; opacity: 0; transition: opacity .4s ease; }
    .cg-item:hover .cg-view { opacity: 1; }
    @media (hover: none) { .cg-view { opacity: 1; } }
</style>
