---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
    project: {
        title: string;
        category: string;
        location: string;
        year: string;
        area: string;
    };
    hero: ImageMetadata;
}

const { project, hero } = Astro.props;
---

<section class="pj-hero on-dark">
    <div class="pj-bg">
        <Image src={hero} alt={project.title} width={Math.min(2400, hero.width)} loading="eager" fetchpriority="high" class="hero-img" />
    </div>
    <div class="pj-shade" aria-hidden="true"></div>

    <div class="wrap pj-inner">
        <div class="pj-head">
            <span class="label" data-reveal>{project.category}</span>
            <h1 data-reveal style="--d:.08s">{project.title}</h1>
        </div>

        <dl class="pj-info" data-reveal style="--d:.16s">
            <div>
                <dt>Location</dt>
                <dd>{project.location}</dd>
            </div>
            <div>
                <dt>Built Up Area</dt>
                <dd>{project.area}</dd>
            </div>
            <div>
                <dt>Completed</dt>
                <dd>{project.year}</dd>
            </div>
        </dl>
    </div>
</section>

<style>
    .pj-hero {
        position: relative;
        display: flex;
        align-items: flex-end;
        min-height: 100svh;
        background: var(--night);
        overflow: hidden;
        isolation: isolate;
    }
    .pj-bg { position: absolute; inset: 0; z-index: -2; }
    .pj-bg :global(img) { width: 100%; height: 100%; object-fit: cover; animation: pj-zoom 2.4s var(--ease) both; }
    @keyframes pj-zoom { from { transform: scale(1.06); } to { transform: none; } }
    .pj-shade {
        position: absolute; inset: 0; z-index: -1;
        background:
            linear-gradient(180deg, rgba(10,10,10,.45) 0%, rgba(10,10,10,0) 22%),
            linear-gradient(0deg, rgba(10,10,10,.75) 0%, rgba(10,10,10,.15) 50%, rgba(10,10,10,0) 100%);
    }

    .pj-inner {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: var(--gap);
        row-gap: 40px;
        align-items: end;
        padding-block: calc(var(--header-h) + 64px) clamp(40px, 6vw, 80px);
    }
    .pj-head { grid-column: 1 / span 7; }
    .pj-head .label { display: block; margin-bottom: 24px; color: rgba(255,255,255,.7); }
    .pj-head h1 { color: #fff; font-size: clamp(3rem, 1.8rem + 6vw, 8rem); }

    .pj-info {
        grid-column: 9 / -1;
        border-top: 1px solid rgba(255,255,255,.24);
    }
    .pj-info > div {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 16px;
        padding: 14px 0;
        border-bottom: 1px solid rgba(255,255,255,.24);
    }
    .pj-info dt { font-size: var(--fs-label); font-weight: 600; letter-spacing: .18em; text-transform: uppercase; color: rgba(255,255,255,.6); }
    .pj-info dd { color: #fff; text-align: right; }

    @media (max-width: 1024px) {
        .pj-head, .pj-info { grid-column: 1 / -1; }
        .pj-info { max-width: 520px; }
    }
</style>
