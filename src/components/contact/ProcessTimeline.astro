---
import SectionHead from "../ui/SectionHead.astro";
import Rows from "../ui/Rows.astro";

const steps = [
    {
        title: "Consultation",
        text: "Understanding your vision, lifestyle, requirements and project goals through detailed discussions.",
    },
    {
        title: "Concept Design",
        text: "Exploring layouts, massing, spatial planning and architectural character to create the perfect direction.",
    },
    {
        title: "Design Development",
        text: "Refining every material, detail and proportion while integrating structure, lighting and functionality.",
    },
    {
        title: "Documentation",
        text: "Producing complete architectural drawings, approvals and technical documentation for execution.",
    },
    {
        title: "Site Supervision",
        text: "Monitoring construction to ensure every detail reflects the original design intent and highest standards.",
    },
];
---

<section class="sec sec--alt process">
    <div class="wrap">
        <SectionHead
            index="04"
            label="Our Process"
            title="From Vision to Reality"
            intro="Every project follows a carefully refined process that transforms ideas into timeless architecture through collaboration, precision and craftsmanship."
        />
        <Rows items={steps} variant="grid" cols={5} />
    </div>
</section>
