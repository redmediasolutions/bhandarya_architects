---
import { img } from "../../consts";
import Btn from "../ui/Btn.astro";

const studioImage = img("2026/05/2.webp");
---

<section class="sec studio">
    <div class="wrap st-grid">

        <figure class="st-figure">
            <div class="media ratio-4-5" data-reveal="mask">
                <img src={studioImage} alt="Bhandary Architects Studio" loading="lazy" decoding="async" width="1365" height="1024" />
            </div>
            <figcaption class="st-cap" data-reveal>
                <strong>25+</strong>
                <span class="label">Years of Architectural Excellence</span>
            </figcaption>
        </figure>

        <div class="st-content">
            <div class="st-label" data-reveal>
                <span class="st-index">03</span>
                <span class="label">Visit Our Studio</span>
            </div>
            <h2 data-reveal style="--d:.05s">Let's Meet, <br class="br-desk" />Discuss & <br class="br-desk" />Design Together.</h2>
            <p class="lead" data-reveal style="--d:.1s">
                Every successful project begins with a meaningful
                conversation. Visit our studio to explore ideas,
                review concepts and collaborate with our architects
                in creating spaces that reflect your aspirations.
            </p>

            <dl class="st-info" data-reveal style="--d:.15s">
                <div>
                    <dt class="label">Studio Address</dt>
                    <dd>Bhandary Architects<br />Mangalore, Karnataka</dd>
                </div>
                <div>
                    <dt class="label">Phone</dt>
                    <dd><a href="tel:+919999999999">+91 99999 99999</a></dd>
                </div>
                <div>
                    <dt class="label">Email</dt>
                    <dd><a href="mailto:info@bhandaryarchitects.com">info@bhandaryarchitects.com</a></dd>
                </div>
                <div>
                    <dt class="label">Working Hours</dt>
                    <dd>Mon – Sat<br />9:00 AM – 6:00 PM</dd>
                </div>
            </dl>

            <div class="btn-row" data-reveal style="--d:.2s">
                <Btn href="https://maps.google.com" target="_blank">View On Google Maps</Btn>
                <Btn href="https://wa.me/919999999999" target="_blank" variant="ghost">WhatsApp Us</Btn>
            </div>
        </div>

    </div>
</section>

<style>
    .st-grid {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: var(--gap);
        row-gap: 64px;
        align-items: center;
    }
    .st-figure { grid-column: 1 / span 5; }
    .st-cap { display: flex; align-items: baseline; gap: 16px; margin-top: 20px; padding-top: 18px; border-top: 1px solid var(--line); }
    .st-cap strong { font-size: 2.4rem; font-weight: 200; letter-spacing: -.04em; line-height: 1; color: var(--ink); }

    .st-content { grid-column: 7 / -1; display: grid; gap: 28px; }
    .st-label { display: flex; gap: 14px; align-items: baseline; }
    .st-index { font-size: var(--fs-label); font-weight: 600; letter-spacing: .12em; color: var(--ink); }
    .st-content .lead { max-width: 50ch; }

    .st-info {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        border-top: 1px solid var(--line);
        margin-block: 8px 16px;
    }
    .st-info > div { padding: 22px 0; border-bottom: 1px solid var(--line); }
    .st-info > div:nth-child(even) { padding-left: var(--gap); border-left: 1px solid var(--line); }
    .st-info dd { margin-top: 8px; color: var(--ink); font-weight: 500; line-height: 1.55; word-break: break-word; }
    .st-info a:hover { opacity: .6; }

    @media (max-width: 899px) {
        .st-figure, .st-content { grid-column: 1 / -1; }
    }
    @media (max-width: 499px) {
        .st-info { grid-template-columns: 1fr; }
        .st-info > div:nth-child(even) { padding-left: 0; border-left: 0; }
    }
</style>
