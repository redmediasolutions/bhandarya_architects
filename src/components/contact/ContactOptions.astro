---
import SectionHead from "../ui/SectionHead.astro";
---

<section class="sec options">
    <div class="wrap">
        <SectionHead
            index="01"
            label="Get In Touch"
            title={["Choose How You'd Like", "To Connect With Us"]}
            intro="Whether you prefer a quick WhatsApp conversation or a detailed project enquiry, we're here to help bring your vision to life."
        />

        <div class="op-grid" data-reveal-stagger=".1">
            <a href="https://wa.me/919999999999" target="_blank" rel="noopener noreferrer" class="op" data-reveal>
                <svg class="op-icon" viewBox="0 0 32 32" aria-hidden="true">
                    <path d="M6 26l1.6-5A10 10 0 1 1 11 24.4L6 26z" />
                    <path d="M12 13.5c0 3.6 2.9 6.5 6.5 6.5" />
                </svg>
                <span class="label">Instant Conversation</span>
                <h3>Chat on <br class="br-desk" />WhatsApp</h3>
                <p>
                    Need a quick discussion about your project?
                    Connect directly with our team for immediate
                    assistance.
                </p>
                <span class="arrow-link"><span>Start Chat</span><span class="ar" aria-hidden="true"></span></span>
            </a>

            <a href="#contact-form" class="op" data-reveal>
                <svg class="op-icon" viewBox="0 0 32 32" aria-hidden="true">
                    <rect x="4" y="8" width="24" height="17" />
                    <path d="M4 8l12 9 12-9" />
                </svg>
                <span class="label">Detailed Enquiry</span>
                <h3>Start Your <br class="br-desk" />Project</h3>
                <p>
                    Tell us about your project, location, budget and
                    expectations. We'll prepare a personalised response.
                </p>
                <span class="arrow-link"><span>Open Form</span><span class="ar" aria-hidden="true"></span></span>
            </a>
        </div>
    </div>
</section>

<style>
    .op-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        border-top: 1px solid var(--line-strong);
    }
    .op {
        display: flex;
        flex-direction: column;
        gap: 18px;
        padding: clamp(32px, 4vw, 56px) clamp(0px, 4vw, 56px) clamp(32px, 4vw, 56px) 0;
        border-bottom: 1px solid var(--line);
        transition: background .5s ease;
    }
    .op + .op { padding-left: clamp(24px, 4vw, 56px); border-left: 1px solid var(--line); }
    .op-icon { width: 34px; height: 34px; fill: none; stroke: var(--ink); stroke-width: 1; margin-bottom: 20px; }
    .op h3 { font-size: clamp(2rem, 1.5rem + 1.8vw, 3.25rem); font-weight: 300; letter-spacing: -.03em; }
    .op p { max-width: 42ch; }
    .op .arrow-link { margin-top: auto; padding-top: 24px; }

    @media (max-width: 799px) {
        .op-grid { grid-template-columns: 1fr; }
        .op + .op { padding-left: 0; border-left: 0; }
    }
</style>
