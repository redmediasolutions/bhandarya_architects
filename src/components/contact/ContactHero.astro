---
import { img } from "../../consts";
import PageHero from "../ui/PageHero.astro";
import ScrollCue from "../ui/ScrollCue.astro";

const hero = img("2026/05/Copy-of-02.webp");
---

<PageHero
    label="Contact Us"
    title={["Let's Create", "Something", "Extraordinary."]}
    text="Whether you're planning your dream residence, a commercial development or a thoughtful interior transformation, we'd love to hear your vision. Every remarkable project begins with a conversation."
    image={hero}
    actions={[
        { text: "Start Your Project", href: "#contact-form" },
        { text: "WhatsApp Us", href: "https://wa.me/919999999999", target: "_blank" },
    ]}
>
    <aside slot="aside" class="ch-card">
        <span class="label ch-head">Available For</span>
        <ul>
            <li>Residential Projects</li>
            <li>Commercial Architecture</li>
            <li>Interior Design</li>
            <li>Renovations & Extensions</li>
        </ul>
        <div class="ch-response">
            <strong>Average Response</strong>
            <span>Within 24 Hours</span>
        </div>
    </aside>

    <ScrollCue text="Scroll" />
</PageHero>

<style>
    .ch-card { color: rgba(255,255,255,.85); }
    .ch-head { color: rgba(255,255,255,.55); display: block; padding-bottom: 14px; border-bottom: 1px solid rgba(255,255,255,.22); }
    .ch-card ul li { padding: 13px 0; border-bottom: 1px solid rgba(255,255,255,.22); font-size: var(--fs-body); }
    .ch-response { display: flex; justify-content: space-between; gap: 16px; padding-top: 18px; font-size: var(--fs-small); }
    .ch-response strong { font-weight: 500; color: rgba(255,255,255,.6); }
    .ch-response span { color: #fff; }

</style>
