---
const steps = [
    "Initial project review",
    "Consultation scheduling",
    "Site discussion",
    "Design proposal",
];
---

<section class="sec sec--white cform" id="contact-form">
    <div class="wrap cf-grid">

        <div class="cf-intro">
            <div class="cf-sticky">
                <div class="cf-label" data-reveal>
                    <span class="cf-index">02</span>
                    <span class="label">Project Enquiry</span>
                </div>
                <h2 data-reveal style="--d:.05s">Tell Us About <br class="br-desk" />Your Vision.</h2>
                <p class="lead" data-reveal style="--d:.1s">
                    Share a few details about your project and our
                    architects will get back to you with the next
                    steps. Every enquiry is reviewed personally.
                </p>

                <div class="cf-next" data-reveal style="--d:.15s">
                    <h4>What happens next?</h4>
                    <ol>
                        {steps.map((s, i) => (
                            <li><span>{String(i + 1).padStart(2, "0")}</span>{s}</li>
                        ))}
                    </ol>
                </div>
            </div>
        </div>

        <form class="cf-form" data-reveal>
            <div class="field">
                <input id="cf-name" type="text" required placeholder=" " autocomplete="name" />
                <label for="cf-name">Full Name</label>
            </div>
            <div class="field">
                <input id="cf-email" type="email" required placeholder=" " autocomplete="email" />
                <label for="cf-email">Email Address</label>
            </div>
            <div class="field">
                <input id="cf-phone" type="tel" placeholder=" " autocomplete="tel" />
                <label for="cf-phone">Phone Number</label>
            </div>
            <div class="field field--select">
                <select id="cf-type" required>
                    <option value=""></option>
                    <option>Residential</option>
                    <option>Commercial</option>
                    <option>Interior Design</option>
                    <option>Renovation</option>
                </select>
                <label for="cf-type">Project Type</label>
            </div>
            <div class="field full">
                <input id="cf-location" type="text" placeholder=" " />
                <label for="cf-location">Project Location</label>
            </div>
            <div class="field field--select">
                <select id="cf-budget">
                    <option value=""></option>
                    <option>Below ₹50 Lakhs</option>
                    <option>₹50L – ₹1Cr</option>
                    <option>₹1Cr – ₹3Cr</option>
                    <option>Above ₹3Cr</option>
                </select>
                <label for="cf-budget">Estimated Budget</label>
            </div>
            <div class="field field--select">
                <select id="cf-timeline">
                    <option value=""></option>
                    <option>Immediately</option>
                    <option>1–3 Months</option>
                    <option>3–6 Months</option>
                    <option>6+ Months</option>
                </select>
                <label for="cf-timeline">Timeline</label>
            </div>
            <div class="field full">
                <textarea id="cf-message" rows="5" placeholder=" "></textarea>
                <label for="cf-message">Tell us about your project</label>
            </div>
            <div class="full cf-submit">
                <button type="submit" class="btn">Send Enquiry</button>
            </div>
        </form>

    </div>
</section>

<script>
    // keep select labels floated once a value is chosen
    document.querySelectorAll<HTMLSelectElement>(".cf-form select").forEach((sel) => {
        const sync = () => sel.classList.toggle("has-value", sel.value !== "");
        sel.addEventListener("change", sync);
        sync();
    });
</script>

<style>
    .cf-grid {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: var(--gap);
        row-gap: 64px;
        align-items: start;
    }
    .cf-intro { grid-column: 1 / span 5; align-self: stretch; }
    .cf-sticky { position: sticky; top: calc(var(--header-h) + 32px); display: grid; gap: 28px; }
    .cf-label { display: flex; gap: 14px; align-items: baseline; }
    .cf-index { font-size: var(--fs-label); font-weight: 600; letter-spacing: .12em; color: var(--ink); }
    .cf-intro h2 { max-width: 12ch; }
    .cf-intro .lead { max-width: 44ch; }

    .cf-next { margin-top: 16px; padding-top: 24px; border-top: 1px solid var(--line); }
    .cf-next h4 { margin-bottom: 14px; }
    .cf-next li { display: flex; gap: 18px; padding: 8px 0; color: var(--ink-2); }
    .cf-next li span { font-size: var(--fs-label); font-weight: 600; letter-spacing: .12em; color: var(--muted); padding-top: .3em; }

    .cf-form {
        grid-column: 7 / -1;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px var(--gap);
    }
    .full { grid-column: 1 / -1; }

    .field { position: relative; }
    .field input,
    .field select,
    .field textarea {
        width: 100%;
        padding: 30px 0 12px;
        border: 0;
        border-bottom: 1px solid var(--line-strong);
        border-radius: 0;
        background: transparent;
        font-size: var(--fs-body);
        color: var(--ink);
        outline: none;
        appearance: none;
        -webkit-appearance: none;
        transition: border-color .3s ease;
    }
    .field textarea { resize: vertical; min-height: 140px; }
    .field input:focus,
    .field select:focus,
    .field textarea:focus { border-color: var(--ink); }

    .field label {
        position: absolute;
        left: 0;
        top: 30px;
        font-size: var(--fs-body);
        color: var(--muted);
        pointer-events: none;
        transform-origin: left top;
        transition: transform .35s var(--ease), color .35s ease;
    }
    .field input:focus + label,
    .field input:not(:placeholder-shown) + label,
    .field textarea:focus + label,
    .field textarea:not(:placeholder-shown) + label,
    .field select:focus + label,
    .field select.has-value + label {
        transform: translateY(-22px) scale(.78);
        color: var(--ink);
        letter-spacing: .02em;
    }

    .field--select::after {
        content: "";
        position: absolute;
        right: 4px;
        top: 38px;
        width: 7px;
        height: 7px;
        border-right: 1px solid var(--ink);
        border-bottom: 1px solid var(--ink);
        transform: rotate(45deg);
        pointer-events: none;
    }

    .cf-submit { padding-top: 32px; }

    @media (max-width: 899px) {
        .cf-intro, .cf-form { grid-column: 1 / -1; }
        .cf-sticky { position: static; }
    }
    @media (max-width: 599px) {
        .cf-form { grid-template-columns: 1fr; }
    }
</style>
