---
import SectionHead from "../ui/SectionHead.astro";

const timeline = [
  {
    year: "1995",
    title: "The Beginning",
    description:
      "Bhandary Architects was founded with a vision to create thoughtful architecture rooted in functionality, craftsmanship and timeless design.",
  },
  {
    year: "2005",
    title: "Growing Beyond Homes",
    description:
      "Expanded into commercial and institutional projects, delivering spaces that balanced aesthetics with practical efficiency.",
  },
  {
    year: "2015",
    title: "Design Recognition",
    description:
      "Received recognition for innovative and sustainable architectural solutions across residential and mixed-use developments.",
  },
  {
    year: "2025",
    title: "Building the Future",
    description:
      "Continuing to shape modern living through architecture, interiors and planning while embracing sustainable design principles.",
  },
];
---

<section class="sec sec--alt timeline">
    <div class="wrap">
        <SectionHead
            index="02"
            label="Our Journey"
            title="Building a Legacy"
            intro="Every milestone represents our commitment to creating meaningful spaces that inspire communities and stand the test of time."
        />

        <ol class="tl" data-reveal-stagger=".1">
            {timeline.map((item) => (
                <li class="tl-item" data-reveal>
                    <span class="tl-year">{item.year}</span>
                    <h3 class="tl-title">{item.title}</h3>
                    <p class="tl-text">{item.description}</p>
                </li>
            ))}
        </ol>
    </div>
</section>

<style>
    .tl {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        column-gap: var(--gap);
        row-gap: 56px;
    }
    .tl-item {
        position: relative;
        padding-top: 28px;
        border-top: 1px solid var(--line-strong);
    }
    .tl-item::before {
        content: "";
        position: absolute;
        top: -4px;
        left: 0;
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--ink);
    }
    .tl-year {
        display: block;
        font-size: clamp(2.6rem, 2rem + 2.4vw, 4.5rem);
        font-weight: 200;
        line-height: 1;
        letter-spacing: -.045em;
        color: var(--ink);
        font-variant-numeric: tabular-nums;
    }
    .tl-title { margin-top: clamp(28px, 4vw, 56px); font-size: var(--fs-h4); font-weight: 500; }
    .tl-text { margin-top: 12px; max-width: 34ch; }

    @media (max-width: 1024px) { .tl { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 599px) { .tl { grid-template-columns: 1fr; } }
</style>
