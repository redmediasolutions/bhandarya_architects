---
import SectionHead from "../ui/SectionHead.astro";

const services = [
  {
    title: "Commercial Architecture",
    description:
      "Innovative designs for corporate spaces that inspire productivity and reflect your brand identity.",
    image: "/images/slides/11.webp",
  },
  {
    title: "Residential Design",
    description:
      "Creating dream homes that blend functionality with aesthetic elegance for modern living.",
    image: "/images/slides/10.webp",
  },
  {
    title: "Interior Design",
    description:
      "Transforming interiors into masterpieces with attention to detail and timeless style.",
    image: "/images/slides/(9).webp",
  },
];

const pad = (n: number) => String(n).padStart(2, "0");
---

<section class="sec sec--white services" id="services">
    <div class="wrap">
        <SectionHead
            index="04"
            label="Our Services"
            title="Complete Architectural Solutions"
            intro="We provide comprehensive architectural and interior design services that transform ideas into enduring spaces."
        />

        <div class="sv-grid" data-reveal-stagger=".1">
            {services.map((service, i) => (
                <article class="sv-item" data-reveal>
                    <a href="/contact" class="sv-link">
                        <div class="media ratio-3-4">
                            <img src={service.image} alt={service.title} loading="lazy" decoding="async" />
                        </div>
                        <div class="sv-body">
                            <span class="sv-num">{pad(i + 1)}</span>
                            <h3 class="sv-title">{service.title}</h3>
                            <p class="sv-desc">{service.description}</p>
                            <span class="arrow-link">
                                <span>Get Started Today</span>
                                <span class="ar" aria-hidden="true"></span>
                            </span>
                        </div>
                    </a>
                </article>
            ))}
        </div>
    </div>
</section>

<style>
    .sv-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--gap);
    }
    .sv-link { display: block; color: var(--ink-2); }
    .sv-body {
        display: grid;
        grid-template-columns: 48px 1fr;
        column-gap: 12px;
        row-gap: 12px;
        padding-top: 24px;
    }
    .sv-num { grid-row: 1; font-size: var(--fs-label); font-weight: 600; letter-spacing: .12em; color: var(--muted); padding-top: .55em; }
    .sv-title { grid-column: 2; font-size: var(--fs-h3); font-weight: 300; letter-spacing: -.02em; }
    .sv-desc { grid-column: 2; max-width: 36ch; }
    .sv-body .arrow-link { grid-column: 2; margin-top: 12px; }

    @media (max-width: 899px) {
        .sv-grid { grid-template-columns: 1fr; row-gap: 56px; }
        .sv-link .media { aspect-ratio: 4 / 3; }
    }
</style>
