---
import SectionHead from "../ui/SectionHead.astro";

const services = [
  {
    title: "Commercial Architecture",
    description:
      "Innovative designs for corporate spaces that inspire productivity and reflect your brand identity.",
    image: "/images/slides/11.webp",
  },
  {
    title: "Residential Design",
    description:
      "Creating dream homes that blend functionality with aesthetic elegance for modern living.",
    image: "/images/slides/10.webp",
  },
  {
    title: "Interior Design",
    description:
      "Transforming interiors into masterpieces with attention to detail and timeless style.",
    image: "/images/slides/(9).webp",
  },
];

const pad = (n: number) => String(n).padStart(2, "0");
---

<section class="sec sec--white services" id="services" data-services>
    <div class="wrap">
        <SectionHead
            index="04"
            label="Our Services"
            title="Complete Architectural Solutions"
            intro="We provide comprehensive architectural and interior design services that transform ideas into enduring spaces."
        />

        <div class="sv">
            <div class="sv-stage" aria-hidden="true">
                <div class="sv-frame" data-reveal="mask">
                    <div class="sv-stack">
                        {services.map((service, i) => (
                            <img
                                src={service.image}
                                alt=""
                                class:list={["sv-img", i === 0 && "active"]}
                                data-i={i}
                                loading="lazy"
                                decoding="async"
                            />
                        ))}
                    </div>
                </div>
                <div class="sv-meta">
                    <span class="sv-meta-n"><span id="sv-current">{pad(1)}</span> / {pad(services.length)}</span>
                </div>
            </div>

            <ol class="sv-list">
                {services.map((service, i) => (
                    <li class:list={["sv-item", i === 0 && "active"]} data-i={i} data-reveal>
                        <a href="/contact" class="sv-link">
                            <img class="sv-thumb" src={service.image} alt={service.title} loading="lazy" decoding="async" />
                            <span class="sv-num">{pad(i + 1)}</span>
                            <h3 class="sv-title">{service.title}</h3>
                            <div class="sv-more">
                                <div class="sv-more-inner">
                                    <p class="sv-desc">{service.description}</p>
                                    <span class="arrow-link">
                                        <span>Get Started Today</span>
                                        <span class="ar" aria-hidden="true"></span>
                                    </span>
                                </div>
                            </div>
                        </a>
                    </li>
                ))}
            </ol>
        </div>
    </div>
</section>

<script>
    document.querySelectorAll<HTMLElement>("[data-services]").forEach((root) => {
        const items = [...root.querySelectorAll<HTMLElement>(".sv-item")];
        const imgs = [...root.querySelectorAll<HTMLElement>(".sv-img")];
        const counter = root.querySelector<HTMLElement>("#sv-current");
        let active = 0;

        const set = (i: number) => {
            if (i === active) return;
            active = i;
            items.forEach((el, k) => el.classList.toggle("active", k === i));
            imgs.forEach((el, k) => el.classList.toggle("active", k === i));
            if (counter) counter.textContent = String(i + 1).padStart(2, "0");
        };

        const desktop = window.matchMedia("(hover: hover) and (min-width: 900px)");

        items.forEach((el, i) => {
            el.addEventListener("pointerenter", () => desktop.matches && set(i));
            el.addEventListener("focusin", () => set(i));
        });

        // on touch screens, the row nearest the middle of the screen becomes active
        const io = new IntersectionObserver((entries) => {
            if (desktop.matches) return;
            entries.forEach((e) => e.isIntersecting && set(items.indexOf(e.target as HTMLElement)));
        }, { rootMargin: "-45% 0px -45% 0px" });
        items.forEach((el) => io.observe(el));
    });
</script>

<style>
    .sv {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: var(--gap);
        align-items: start;
    }

    /* image stage */
    .sv-stage { grid-column: 1 / span 5; position: sticky; top: calc(var(--header-h) + 32px); }
    .sv-frame { aspect-ratio: 4 / 5; position: relative; overflow: hidden; background: var(--paper-2); }
    .sv-stack { position: absolute; inset: 0; }
    .sv-img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        transform: scale(1.08);
        clip-path: inset(0 0 0 100%);
        transition: opacity .01s linear .9s, transform 1.6s var(--ease), clip-path 1.1s cubic-bezier(.77, 0, .18, 1);
    }
    .sv-img.active {
        z-index: 1;
        opacity: 1;
        transform: scale(1);
        clip-path: inset(0 0 0 0);
        transition: opacity .01s linear, transform 1.6s var(--ease), clip-path 1.1s cubic-bezier(.77, 0, .18, 1);
    }
    .sv-meta {
        display: flex;
        justify-content: space-between;
        padding-top: 16px;
        font-size: var(--fs-label);
        font-weight: 600;
        letter-spacing: .14em;
        color: var(--muted);
    }
    .sv-meta-n span { color: var(--ink); }

    /* list */
    .sv-list { grid-column: 7 / -1; border-top: 1px solid var(--line-strong); }
    .sv-item { border-bottom: 1px solid var(--line); }
    .sv-link {
        display: grid;
        grid-template-columns: 56px 1fr;
        align-items: baseline;
        padding: clamp(28px, 3.4vw, 48px) 0;
        color: var(--ink);
    }
    .sv-thumb { display: none; }
    .sv-num {
        font-size: var(--fs-label);
        font-weight: 600;
        letter-spacing: .12em;
        color: var(--muted);
        transition: color .4s ease;
    }
    .sv-title {
        font-size: clamp(1.9rem, 1.3rem + 2.2vw, 3.4rem);
        font-weight: 300;
        letter-spacing: -.035em;
        line-height: 1.05;
        color: var(--muted);
        transition: color .5s ease, transform .7s var(--ease);
    }
    .sv-item.active .sv-title { color: var(--ink); transform: translateX(14px); }
    .sv-item.active .sv-num { color: var(--ink); }

    .sv-more {
        grid-column: 2;
        display: grid;
        grid-template-rows: 0fr;
        transition: grid-template-rows .7s var(--ease);
    }
    .sv-item.active .sv-more { grid-template-rows: 1fr; }
    .sv-more-inner {
        overflow: hidden;
        display: grid;
        gap: 18px;
        padding-left: 14px;
        opacity: 0;
        transition: opacity .5s ease;
    }
    .sv-item.active .sv-more-inner { opacity: 1; transition-delay: .15s; }
    .sv-desc { padding-top: 18px; max-width: 40ch; color: var(--ink-2); }
    .sv-more .arrow-link { padding-bottom: 4px; }

    :global(html:not(.js)) .sv-more { grid-template-rows: 1fr; }
    :global(html:not(.js)) .sv-more-inner { opacity: 1; }

    @media (max-width: 899px) {
        .sv-stage { display: none; }
        .sv-list { grid-column: 1 / -1; }
        .sv-link { grid-template-columns: 40px 1fr; }
        .sv-thumb {
            display: block;
            grid-column: 1 / -1;
            width: 100%;
            aspect-ratio: 4 / 3;
            object-fit: cover;
            margin-bottom: 24px;
        }
        .sv-title { color: var(--ink); }
        .sv-item.active .sv-title { transform: none; }
        .sv-more { grid-template-rows: 1fr; }
        .sv-more-inner { opacity: 1; padding-left: 0; }
    }
</style>
