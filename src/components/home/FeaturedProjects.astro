---
import residential from "../../content/residential";
import commercial from "../../content/commercial";
import interior from "../../content/interiors";
import educational from "../../content/educational";

import { getResidentialImages } from "../../lib/residentialImages";
import { getCommercialImages } from "../../lib/commercialImages";
import { getInteriorImages } from "../../lib/interiorImages";
import { getEducationalImages } from "../../lib/educationalImages";

import SectionHead from "../ui/SectionHead.astro";
import ProjectCard from "../ui/ProjectCard.astro";
import Btn from "../ui/Btn.astro";

const latestProjects = [
    ...residential.slice(0, 3).map(project => ({
        ...project,
        category: "Residential",
        href: `/projects/residences/${project.slug}`,
        image: getResidentialImages(project.folder).hero
    })),
    ...commercial.slice(0, 3).map(project => ({
        ...project,
        category: "Commercial",
        href: `/projects/commercial/${project.slug}`,
        image: getCommercialImages(project.folder).hero
    })),
    ...interior.slice(0, 3).map(project => ({
        ...project,
        category: "Interior",
        href: `/projects/interiors/${project.slug}`,
        image: getInteriorImages(project.folder).hero
    })),
    ...educational.slice(0, 3).map(project => ({
        ...project,
        category: "Educational",
        href: `/projects/educational/${project.slug}`,
        image: getEducationalImages(project.folder).hero
    }))
];

/* editorial rhythm: wide / narrow pairs that alternate sides */
const layout = ["w", "n", "n", "w"];
---

<section class="sec featured">
    <div class="wrap">
        <SectionHead index="03" label="Featured Projects" title="Spaces Crafted with Purpose">
            <div class="fp-all" data-reveal style="--d:.15s">
                <Btn href="/projects" variant="arrow">View All Projects</Btn>
            </div>
        </SectionHead>

        <div class="fp-grid">
            {latestProjects.map((project, index) => {
                const kind = layout[index % 4];
                return (
                    <ProjectCard
                        href={project.href}
                        image={project.image}
                        title={project.title}
                        eyebrow={project.category}
                        ratio={kind === "w" ? "ratio-3-2" : "ratio-4-5"}
                        width={kind === "w" ? 1400 : 1000}
                        class={`fp-item fp-${kind}`}
                    />
                );
            })}
        </div>
    </div>
</section>

<style>
    .fp-all { margin-top: 36px; }

    .fp-grid {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: var(--gap);
        row-gap: clamp(56px, 7vw, 112px);
        align-items: start;
    }
    .fp-grid :global(.fp-item:nth-child(4n + 1)) { grid-column: 1 / span 7; }
    .fp-grid :global(.fp-item:nth-child(4n + 2)) { grid-column: 9 / span 4; margin-top: clamp(80px, 12vw, 200px); }
    .fp-grid :global(.fp-item:nth-child(4n + 3)) { grid-column: 2 / span 4; }
    .fp-grid :global(.fp-item:nth-child(4n + 4)) { grid-column: 6 / span 7; margin-top: clamp(80px, 12vw, 200px); }

    @media (max-width: 899px) {
        .fp-grid { row-gap: 48px; }
        .fp-grid :global(.fp-item) { grid-column: 1 / -1 !important; margin-top: 0 !important; }
    }
</style>
