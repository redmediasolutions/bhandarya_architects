---
/**
 * Legacy single-project template (used by /samudra and /kuitra).
 * Shares the visual language of the new project pages.
 */
import Header from "../layouts/Header.astro";
import Footer from "../layouts/Footer.astro";

interface GallerySection {
    label?: string;
    images: string[];
    layout?: "grid" | "carousel";
}

interface Props {
    category: string;
    title: string;
    hero: string;
    overview: string[];
    features: string[][];
    galleryTitle?: string;
    galleries: GallerySection[];
    slides?: string[];
    team: { name: string; role: string }[];
    details: { label: string; value: string }[];
}

const {
    category,
    title,
    hero,
    overview,
    features,
    galleryTitle = "Project Gallery",
    galleries,
    slides = [],
    team,
    details,
} = Astro.props;
---

<Header />

<main>
    <section class="pd-hero on-dark">
        <img class="pd-hero-img" src={hero} alt={title} loading="eager" fetchpriority="high" />
        <div class="pd-shade" aria-hidden="true"></div>
        <div class="wrap pd-hero-inner">
            <span class="label" data-reveal>{category}</span>
            <h1 data-reveal style="--d:.08s">{title}</h1>
        </div>
    </section>

    <section class="sec">
        <div class="wrap pd-grid">
            <div class="pd-main">
                <h2 class="pd-title" data-reveal>Project Overview</h2>
                <div class="pd-overview">
                    {overview.map((para) => <p data-reveal set:html={para} />)}
                </div>

                <h3 class="pd-label label" data-reveal>Key Features</h3>
                <div class="pd-features" data-reveal>
                    {features.map((list) => (
                        <ul>{list.map((f) => <li>{f}</li>)}</ul>
                    ))}
                </div>

                <h3 class="pd-label label" data-reveal>Project Team</h3>
                <ul class="pd-team" data-reveal>
                    {team.map((m) => (
                        <li>
                            <h4>{m.name}</h4>
                            <p>{m.role}</p>
                        </li>
                    ))}
                </ul>
            </div>

            <aside class="pd-side">
                <div class="pd-details" data-reveal>
                    <h3 class="label">Project Details</h3>
                    {details.map((d) => (
                        <div class="pd-row">
                            <h4>{d.label}</h4>
                            <p>{d.value}</p>
                        </div>
                    ))}
                </div>
            </aside>
        </div>
    </section>

    <section class="sec sec--white pd-galleries">
        <div class="wrap">
            <h2 class="pd-gtitle" data-reveal>{galleryTitle}</h2>

            {galleries.map((g) => (
                <div class="pd-block">
                    {g.label && <h3 class="label pd-glabel">{g.label}</h3>}
                    <div class:list={[g.layout === "carousel" ? "pd-track" : "pd-gallery"]} data-gallery>
                        {g.images.map((src, i) => (
                            <a href={src} class="pd-item" data-pswp-width="1600" data-pswp-height="1067">
                                <div class="media">
                                    <img src={src} alt={`${title} — ${g.label ?? "gallery"} image ${i + 1}`} loading="lazy" decoding="async" />
                                </div>
                            </a>
                        ))}
                    </div>
                </div>
            ))}

            {slides.length > 0 && (
                <div class="pd-block">
                    <div class="pd-track" data-gallery>
                        {slides.map((src, i) => (
                            <a href={src} class="pd-item" data-pswp-width="1600" data-pswp-height="1067">
                                <div class="media">
                                    <img src={src} alt={`${title} image ${i + 1}`} loading="lazy" decoding="async" />
                                </div>
                            </a>
                        ))}
                    </div>
                </div>
            )}
        </div>
    </section>
</main>

<Footer />

<script>
    import "../scripts/lightbox";

    // read real image dimensions so the lightbox opens at the correct ratio
    document.querySelectorAll<HTMLAnchorElement>(".pd-item").forEach((a) => {
        const img = a.querySelector("img");
        const set = () => {
            if (!img?.naturalWidth) return;
            a.dataset.pswpWidth = String(img.naturalWidth * 2);
            a.dataset.pswpHeight = String(img.naturalHeight * 2);
        };
        img?.complete ? set() : img?.addEventListener("load", set);
    });
</script>

<style>
    .pd-hero { position: relative; display: flex; align-items: flex-end; min-height: 100svh; background: var(--night); overflow: hidden; isolation: isolate; }
    .pd-hero-img { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; }
    .pd-shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(0deg, rgba(10,10,10,.75), rgba(10,10,10,.1) 55%), linear-gradient(180deg, rgba(10,10,10,.45), transparent 22%); }
    .pd-hero-inner { padding-block: calc(var(--header-h) + 64px) clamp(48px, 7vw, 104px); }
    .pd-hero-inner .label { display: block; margin-bottom: 24px; color: rgba(255,255,255,.7); }
    .pd-hero h1 { color: #fff; font-size: clamp(3rem, 1.8rem + 6vw, 8rem); }

    .pd-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); row-gap: 56px; align-items: start; }
    .pd-main { grid-column: 1 / span 7; }
    .pd-side { grid-column: 9 / -1; align-self: stretch; }
    .pd-details { position: sticky; top: calc(var(--header-h) + 32px); border-top: 1px solid var(--line-strong); padding-top: 18px; }
    .pd-row { display: flex; justify-content: space-between; gap: 20px; padding: 15px 0; border-bottom: 1px solid var(--line); }
    .pd-row h4 { font-size: var(--fs-small); font-weight: 400; color: var(--muted); }
    .pd-row p { color: var(--ink); font-weight: 500; text-align: right; }

    .pd-title { font-size: clamp(1.8rem, 1.4rem + 1.4vw, 2.6rem); margin-bottom: 32px; }
    .pd-overview { display: grid; gap: 22px; max-width: 66ch; }
    .pd-overview p { font-size: 1.02rem; line-height: 1.85; }
    .pd-label { display: block; margin: 64px 0 20px; }

    .pd-features { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--gap); border-top: 1px solid var(--line); }
    .pd-features li { padding: 14px 0; border-bottom: 1px solid var(--line); color: var(--ink); }

    .pd-team { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--gap); }
    .pd-team li { padding-top: 16px; border-top: 1px solid var(--line); }
    .pd-team h4 { font-weight: 500; }
    .pd-team p { color: var(--muted); font-size: var(--fs-small); }

    .pd-gtitle { margin-bottom: 56px; }
    .pd-block + .pd-block { margin-top: clamp(64px, 8vw, 120px); }
    .pd-glabel { display: block; margin-bottom: 20px; }
    .pd-gallery { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gap); }
    .pd-gallery .media { aspect-ratio: 4 / 3; }
    .pd-track { display: flex; gap: var(--gap); overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 16px; }
    .pd-track .pd-item { flex: 0 0 clamp(260px, 30vw, 440px); scroll-snap-align: start; }
    .pd-track .media { aspect-ratio: 3 / 4; }
    .pd-item { display: block; cursor: zoom-in; }

    @media (max-width: 899px) {
        .pd-main, .pd-side { grid-column: 1 / -1; }
        .pd-details { position: static; }
        .pd-gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @media (max-width: 599px) {
        .pd-features, .pd-team, .pd-gallery { grid-template-columns: 1fr; }
    }
</style>
