---
import { img } from "../../consts";
import SectionHead from "../ui/SectionHead.astro";

const leaders = [
  {
    name: "Ar. Amarnath Bhandary",
    role: "Principal Architect",
    image: img("2026/03/photo-1506794778202-cad84cf45f1d.avif"),
    bio: `With over three decades of architectural experience, Amarnath
Bhandary has led the practice with a vision rooted in timeless design,
functionality and innovation. His work reflects a deep understanding of
people, place and purpose, resulting in projects that remain relevant for
generations.`,
  },
  {
    name: "Ar. Sarina Bhandary",
    role: "Principal Architect",
    image: img("2026/03/photo-1506794778202-cad84cf45f1d.avif"),
    bio: `Sarina Bhandary brings a thoughtful and human-centred approach to
architecture and interiors. Her attention to detail, materiality and
spatial planning ensures that every project delivers beauty, comfort and
lasting value.`,
  },
];
---

<section class="sec sec--alt leadership">
    <div class="wrap">
        <SectionHead
            index="03"
            label="Leadership"
            title="Meet Our Principal Architects"
            intro="Every successful project begins with strong leadership, thoughtful collaboration and decades of architectural experience."
        />

        <div class="ld-list">
            {leaders.map((leader, index) => (
                <article class="ld" data-reveal>
                    <span class="ld-num">{String(index + 1).padStart(2, "0")}</span>
                    <div class="media ratio-4-5 ld-photo">
                        <img src={leader.image} alt={leader.name} loading="lazy" decoding="async" width="400" height="600" />
                    </div>
                    <div class="ld-body">
                        <span class="label">{leader.role}</span>
                        <h3 class="ld-name">{leader.name}</h3>
                        <p>{leader.bio}</p>
                    </div>
                </article>
            ))}
        </div>
    </div>
</section>

<style>
    .ld-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--gap); }
    .ld {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
        column-gap: var(--gap);
        row-gap: 18px;
        padding-top: 20px;
        border-top: 1px solid var(--line-strong);
    }
    .ld-num { grid-column: 1 / -1; font-size: var(--fs-label); font-weight: 600; letter-spacing: .12em; color: var(--ink); }
    .ld-photo img { filter: grayscale(1); transition: filter 1s var(--ease), transform 1.4s var(--ease); }
    .ld:hover .ld-photo img { filter: grayscale(0); }
    .ld-body { display: flex; flex-direction: column; gap: 14px; }
    .ld-name { font-size: var(--fs-h3); font-weight: 300; margin-bottom: 8px; }
    .ld-body p { font-size: var(--fs-small); line-height: 1.8; }

    @media (max-width: 1100px) {
        .ld-list { grid-template-columns: 1fr; row-gap: 64px; }
        .ld { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
    }
    @media (max-width: 599px) {
        .ld { grid-template-columns: 1fr; }
    }
</style>
