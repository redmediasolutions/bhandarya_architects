---
import Stats from "../ui/Stats.astro";

const stats = [
    { value: "30+", label: "Years Experience" },
    { value: "500+", label: "Projects" },
    { value: "100+", label: "Happy Clients" },
    { value: "1995", label: "Established" },
];
---

<section class="sec--tight statistics">
    <div class="wrap">
        <Stats items={stats} />
    </div>
</section>

<style>
    .statistics { padding-bottom: var(--space-sm); margin-top: calc(var(--space) * -0.4); }
</style>
