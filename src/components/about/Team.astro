---
import { img } from "../../consts";
import SectionHead from "../ui/SectionHead.astro";

const team = [
  { name: "Anil Kumar", role: "Project Manager" },
  { name: "Meera Patel", role: "Interior Designer" },
  { name: "Rahul Sharma", role: "Architect" },
  { name: "Priya Nair", role: "Architect" },
];

const portrait = img("2026/03/photo-1506794778202-cad84cf45f1d.avif");
---

<section class="sec team">
    <div class="wrap">
        <SectionHead
            index="04"
            label="Our Team"
            title="Meet the People Behind Every Project"
            intro="Our multidisciplinary team brings together architects, designers and project managers committed to creating spaces that inspire and endure."
        />

        <ul class="tm-grid" data-reveal-stagger=".08">
            {team.map((member) => (
                <li class="tm" data-reveal>
                    <div class="media ratio-3-4">
                        <img src={portrait} alt={member.name} loading="lazy" decoding="async" width="400" height="600" />
                    </div>
                    <h3 class="tm-name">{member.name}</h3>
                    <span class="tm-role">{member.role}</span>
                </li>
            ))}
        </ul>
    </div>
</section>

<style>
    .tm-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 56px var(--gap); }
    .tm img { filter: grayscale(1); transition: filter 1s var(--ease), transform 1.4s var(--ease); }
    .tm:hover img { filter: grayscale(0); }
    .tm-name { margin-top: 18px; font-size: var(--fs-h4); font-weight: 500; }
    .tm-role { display: block; margin-top: 4px; font-size: var(--fs-small); color: var(--muted); }
    @media (max-width: 899px) { .tm-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
