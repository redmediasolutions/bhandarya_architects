    <path d="M230 240 L230 520 L770 520 L770 240"/>

    <path d="M455 520 L455 340 L545 340 L545 520"/>

    <rect x="300" y="320" width="90" height="90"/>

    <rect x="610" y="320" width="90" height="90"/>

    <line x1="180" y1="240" x2="820" y2="240"/>

    <!-- ========================= -->
    <!-- FLOOR PLAN -->
    <!-- ========================= -->

    <rect x="120" y="560" width="250" height="140"/>

    <line x1="245" y1="560" x2="245" y2="700"/>

