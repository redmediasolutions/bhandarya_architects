    <line x1="700" y1="620" x2="820" y2="620"/>

    <!-- ========================= -->
    <!-- DIMENSIONS -->
    <!-- ========================= -->

    <line x1="180" y1="540" x2="820" y2="540"/>

    <line x1="180" y1="535" x2="180" y2="545"/>

    <line x1="820" y1="535" x2="820" y2="545"/>

    <text x="500" y="534" text-anchor="middle">

        12000

