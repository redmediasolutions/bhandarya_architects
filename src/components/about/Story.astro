    <!-- ========================= -->

    <circle cx="920" cy="120" r="26"/>

    <line x1="920" y1="146" x2="920" y2="95"/>

    <polygon points="920,78 913,96 927,96"/>

    <text x="913" y="165">N</text>

    <!-- ========================= -->
