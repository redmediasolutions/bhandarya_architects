    <!-- ========================= -->

    <text x="740" y="730">

        SCALE 1 : 100

    </text>

</svg>

            </figure>

            <div class="st-copy" data-reveal style="--d:.1s">
                <p class="lead">
                    Founded in 1995, Bhandary Associates has been at the
                    forefront of architectural innovation for three decades.
                    What started as a small practice with a vision for
                    excellence has grown into one of the most respected
                    architecture firms in the region.
                </p>
                <p>
                    Our journey has been defined by a commitment to pushing
                    boundaries while respecting tradition.
                </p>
                <p>
                    Today, our portfolio spans residential, commercial and
                    urban planning projects, each bearing the hallmark of
                    sustainable design, functional beauty and client
                    satisfaction.
                </p>
            </div>
        </div>
    </div>
</section>

<style>
    .st-grid {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: var(--gap);
        row-gap: 56px;
        align-items: start;
    }
    .st-drawing {
        grid-column: 1 / span 6;
        padding: clamp(16px, 2vw, 28px);
        background: var(--white);
        border: 1px solid var(--line);
    }
    .st-copy { grid-column: 8 / -1; display: grid; gap: 22px; max-width: 54ch; }

    .st-drawing svg { width: 100%; height: auto; overflow: visible; }
    .st-drawing :global(rect),
    .st-drawing :global(path),
    .st-drawing :global(line),
    .st-drawing :global(circle),
    .st-drawing :global(polygon) {
        fill: none;
        stroke: var(--ink);
        stroke-width: 1;
        vector-effect: non-scaling-stroke;
        stroke-dasharray: 1600;
        stroke-dashoffset: 1600;
        transition: stroke-dashoffset 3.2s var(--ease);
    }
    .st-drawing :global(polygon) { fill: var(--ink); }
    .st-drawing :global(text) {
        fill: var(--muted);
        font-family: var(--font);
        font-size: 13px;
        letter-spacing: .14em;
    }
    .st-drawing.is-in :global(rect),
    .st-drawing.is-in :global(path),
    .st-drawing.is-in :global(line),
    .st-drawing.is-in :global(circle),
    .st-drawing.is-in :global(polygon) { stroke-dashoffset: 0; }
    :global(html:not(.js)) .st-drawing :global(*) { stroke-dashoffset: 0; }

    @media (max-width: 899px) {
        .st-drawing, .st-copy { grid-column: 1 / -1; }
    }
</style>
