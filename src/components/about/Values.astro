---
import SectionHead from "../ui/SectionHead.astro";
import Rows from "../ui/Rows.astro";

const values = [
  {
    title: "Excellence",
    text: "We pursue the highest standards in every project we undertake.",
  },
  {
    title: "Collaboration",
    text: "Working closely with clients to bring their vision to life through open communication and shared creativity.",
  },
  {
    title: "Innovation",
    text: "Embracing new technologies and sustainable design practices to create future-ready spaces.",
  },
  {
    title: "Passion",
    text: "Every design reflects our deep commitment to architectural excellence and thoughtful craftsmanship.",
  },
];
---

<section class="sec values" id="values">
    <div class="wrap">
        <SectionHead
            index="02"
            label="Our Values"
            title={["The Principles That", "Guide Every Project"]}
            intro="Our work is shaped by thoughtful design, meaningful collaboration and a passion for creating spaces that enrich everyday life."
        />
        <Rows items={values} variant="grid" cols={4} />
    </div>
</section>
