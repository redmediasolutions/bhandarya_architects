---
import residential from "../../content/residential";
import commercial from "../../content/commercial";
import interior from "../../content/interiors";
import educational from "../../content/educational";

import { getResidentialImages } from "../../lib/residentialImages";
import { getCommercialImages } from "../../lib/commercialImages";
import { getInteriorImages } from "../../lib/interiorImages";
import { getEducationalImages } from "../../lib/educationalImages";

import SectionHead from "../ui/SectionHead.astro";
import ProjectCard from "../ui/ProjectCard.astro";

const projects = [
    ...residential.map(project => ({
        title: project.title,
        category: "Residential",
        image: getResidentialImages(project.folder).hero,
        href: `/projects/residences/${project.slug}`,
    })),
    ...commercial.map(project => ({
        title: project.title,
        category: "Commercial",
        image: getCommercialImages(project.folder).hero,
        href: `/projects/commercial/${project.slug}`,
    })),
    ...interior.map(project => ({
        title: project.title,
        category: "Interior",
        image: getInteriorImages(project.folder).hero,
        href: `/projects/interiors/${project.slug}`,
    })),
    ...educational.map(project => ({
        title: project.title,
        category: "Educational",
        image: getEducationalImages(project.folder).hero,
        href: `/projects/educational/${project.slug}`,
    }))
];
---

<section class="sec sec--white featured-all" id="featured">
    <div class="wrap">
        <SectionHead
            index="02"
            label="Featured Projects"
            title="Our Projects"
            intro="Every project reflects our pursuit of timeless architecture, thoughtful planning and enduring craftsmanship."
        />

        <div class="pj-grid">
            {projects.map((project, index) => (
                <ProjectCard
                    href={project.href}
                    image={project.image}
                    title={project.title}
                    eyebrow={project.category}
                    ratio={index === 0 ? "ratio-16-9" : "ratio-4-3"}
                    width={index === 0 ? 1800 : 1000}
                    class={index === 0 ? "pj-lead" : undefined}
                />
            ))}
        </div>
    </div>
</section>

<style>
    .pj-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: clamp(48px, 5vw, 80px) var(--gap);
    }
    .pj-grid :global(.pj-lead) { grid-column: 1 / -1; }
    @media (max-width: 1024px) { .pj-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 599px) { .pj-grid { grid-template-columns: 1fr; } }
</style>
