---
import SectionHead from "../ui/SectionHead.astro";
import Stats from "../ui/Stats.astro";

const sectors = [
  {
    title: "Residences",
    count: "68",
    text: "Private homes, villas and premium residences crafted for modern living.",
    href: "/projects/residences",
  },
  {
    title: "Commercial",
    count: "31",
    text: "Corporate offices, retail environments and mixed-use developments.",
    href: "/projects/commercial",
  },
  {
    title: "Interior",
    count: "21",
    text: "Luxury interior environments tailored to each client.",
    href: "/projects/interiors",
  },
  {
    title: "Educational Institutions",
    count: "21",
    text: "Learning environments designed for the next generation.",
    href: "/projects/educational",
  },
];
---

<section class="sec intro">
    <div class="intro-word" aria-hidden="true">PROJECTS</div>

    <div class="wrap">
        <SectionHead
            index="01"
            label="Featured Work"
            title={["Every project tells", "a different story."]}
            intro="Over two decades of architecture across residential, commercial and hospitality sectors, shaped by thoughtful design and timeless craftsmanship."
        />

        <div class="intro-stats">
            <Stats items={[
                { value: "120+", label: "Projects" },
                { value: "25+", label: "Years" },
                { value: "3.5M+", label: "Sq.ft Designed" },
            ]} />
        </div>

        <ul class="sectors" data-reveal-stagger=".07">
            {sectors.map((sector) => (
                <li data-reveal>
                    <a href={sector.href} class="sector">
                        <span class="sector-count">{sector.count}</span>
                        <h3 class="sector-title">{sector.title}</h3>
                        <p class="sector-text">{sector.text}</p>
                        <span class="arrow-link sector-cta">
                            <span>Explore</span>
                            <span class="ar" aria-hidden="true"></span>
                        </span>
                    </a>
                </li>
            ))}
        </ul>
    </div>
</section>

<style>
    .intro { overflow: hidden; }
    .intro-word {
        position: absolute;
        top: clamp(24px, 3vw, 48px);
        right: calc(var(--gutter) * -0.2);
        font-size: clamp(5rem, 16vw, 15rem);
        font-weight: 200;
        letter-spacing: -.05em;
        line-height: .8;
        color: transparent;
        -webkit-text-stroke: 1px rgba(21,21,21,.08);
        pointer-events: none;
        user-select: none;
    }

    .intro-stats { margin-bottom: clamp(64px, 8vw, 120px); }
    @media (min-width: 900px) {
        .intro-stats { margin-left: calc((100% + var(--gap)) * 4 / 12); }
    }

    .sectors { border-top: 1px solid var(--line-strong); }
    .sectors li { border-bottom: 1px solid var(--line); }
    .sector {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: var(--gap);
        align-items: baseline;
        padding: clamp(24px, 3vw, 40px) 0;
        transition: padding .5s var(--ease), background .5s ease;
    }
    .sector:hover { padding-left: 16px; }
    .sector-count {
        grid-column: 1 / span 2;
        font-size: clamp(2rem, 1.5rem + 1.6vw, 3.25rem);
        font-weight: 200;
        letter-spacing: -.04em;
        line-height: 1;
        color: var(--ink);
    }
    .sector-title { grid-column: 3 / span 4; font-size: var(--fs-h3); font-weight: 300; }
    .sector-text { grid-column: 7 / span 4; max-width: 40ch; }
    .sector-cta { grid-column: 11 / -1; justify-self: end; }

    @media (max-width: 899px) {
        .sector { grid-template-columns: 64px 1fr; row-gap: 10px; }
        .sector-count { grid-column: 1; grid-row: 1 / span 3; font-size: 1.8rem; }
        .sector-title, .sector-text, .sector-cta { grid-column: 2; justify-self: start; }
        .sector:hover { padding-left: 0; }
    }
</style>
