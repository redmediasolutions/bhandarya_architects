---
import { img } from "../../consts";
import PageHero from "../ui/PageHero.astro";

const hero = img("2026/05/Copy-of-08-1024x683.webp");

const types = [
    { name: "Residential", href: "/projects/residences" },
    { name: "Interior", href: "/projects/interiors" },
    { name: "Commercial", href: "/projects/commercial" },
    { name: "Educational", href: "/projects/educational" },
];
---

<PageHero
    label="Our Portfolio"
    title={["Projects That", "Stand The Test", "of Time."]}
    text="From luxury residences to commercial developments, every project is designed with clarity, purpose and enduring architectural character."
    image={hero}
    actions={[{ text: "View Featured Projects", href: "#featured" }]}
    stats={[
        { value: "25+", label: "Years Experience" },
        { value: "120+", label: "Completed Projects" },
        { value: "3.5M+", label: "Sq.ft Designed" },
    ]}
/>

<nav class="ptypes" aria-label="Project categories">
        <div class="wrap ptypes-inner">
            {types.map((t, i) => (
                <a href={t.href}>
                    <span class="ptypes-i">{String(i + 1).padStart(2, "0")}</span>
                    <span>{t.name}</span>
                </a>
            ))}
        </div>
</nav>

<style>
    .ptypes { background: var(--paper); border-bottom: 1px solid var(--line); }
    .ptypes-inner { display: flex; flex-wrap: wrap; }
    .ptypes a {
        flex: 1 1 0;
        display: inline-flex;
        gap: 14px;
        align-items: baseline;
        padding: 26px 0;
        font-size: var(--fs-label);
        font-weight: 600;
        letter-spacing: .2em;
        text-transform: uppercase;
        color: var(--ink);
        transition: opacity .3s ease;
    }
    .ptypes a + a { padding-left: var(--gap); border-left: 1px solid var(--line); }
    .ptypes a:hover { opacity: .55; }
    .ptypes-i { color: var(--muted); letter-spacing: .1em; }
    @media (max-width: 699px) {
        .ptypes a { flex: 1 1 50%; padding: 18px 0; }
        .ptypes a:nth-child(3) { padding-left: 0; border-left: 0; }
        .ptypes a:nth-child(n+3) { border-top: 1px solid var(--line); }
    }
</style>
