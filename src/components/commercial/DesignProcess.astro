---
import SectionHead from "../ui/SectionHead.astro";
import Rows from "../ui/Rows.astro";

const steps = [
  {
    number: "01",
    title: "Discovery",
    text: "Understanding business objectives, operational workflows and long-term growth plans before design begins."
  },
  {
    number: "02",
    title: "Planning",
    text: "Master planning, circulation studies and spatial strategies that maximize efficiency and user experience."
  },
  {
    number: "03",
    title: "Design Development",
    text: "Refining architecture through materiality, sustainability and detailed technical coordination."
  },
  {
    number: "04",
    title: "Execution",
    text: "Collaborating closely with consultants and contractors to deliver exceptional built outcomes."
  }
];
---

<section class="sec sec--alt">
    <div class="wrap">
        <SectionHead
            index="04"
            label="Our Process"
            title={["A Collaborative Journey", "From Vision To Reality"]}
            intro="Every commercial project follows a structured architectural process that balances creativity, technical precision and business objectives."
        />
        <Rows items={steps.map((s) => ({ num: s.number, title: s.title, text: s.text }))} variant="grid" cols={4} />
    </div>
</section>
