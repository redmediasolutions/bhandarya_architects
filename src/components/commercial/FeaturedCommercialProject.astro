---
import projects from "../../content/commercial";
import { getCommercialImages } from "../../lib/commercialImages";
import SectionHead from "../ui/SectionHead.astro";
import Featured from "../ui/Featured.astro";

const project = projects.find((p) => p.featured) ?? projects[0];
const { hero } = getCommercialImages(project.folder);
const href = `/projects/commercial/${project.slug}`;
---

<section class="sec sec--white" id="featured">
    <div class="wrap">
        <SectionHead index="02" label="Featured Commercial Project" title="Featured Project" />

        <Featured
            href={href}
            image={hero}
            tag="Featured Project"
            eyebrow={project.subtitle}
            name={project.title}
            paragraphs={project.description.slice(0, 2)}
            meta={[
                { label: "Project Type", value: project.subtitle },
                { label: "Location", value: project.location },
                { label: "Area", value: project.area },
                {
                    label: project.status === "Completed" ? "Completed" : "Status",
                    value: project.status === "Completed" ? project.year : project.status,
                },
            ]}
            cta="View Project"
            reverse
        />
    </div>
</section>
