---
import { img } from "../../consts";
import Cta from "../ui/Cta.astro";

const background = img("2026/03/Screenshot-2026-03-25-154852.png");
const sectors = [
    "Commercial Offices",
    "Retail & Showrooms",
    "Educational Campuses",
    "Hospitality Projects",
    "Mixed-use Developments",
];
---

<Cta
    label="Let's Build Together"
    title={["Ready To Create", "Your Next Commercial", "Landmark?"]}
    text="Whether you're planning a corporate office, retail destination, educational campus or mixed-use development, we would love to discuss your vision."
    image={background}
    actions={[
        { text: "Schedule Consultation", href: "/contact" },
        { text: "WhatsApp Us", href: "https://wa.me/919876543210", target: "_blank" },
    ]}
>
    <div class="cc-card" data-reveal>
        <h3 class="cc-title">Start Your Project</h3>
        <ul class="cc-list">
            {sectors.map((s) => <li>{s}</li>)}
        </ul>
        <dl class="cc-contact">
            <div>
                <dt class="label">Email</dt>
                <dd>studio@bhandaryarchitects.com</dd>
            </div>
            <div>
                <dt class="label">Phone</dt>
                <dd>+91 98765 43210</dd>
            </div>
        </dl>
    </div>
</Cta>

<style>
    .cc-card {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 32px var(--gap);
        margin-top: clamp(48px, 6vw, 80px);
        padding-top: 32px;
        border-top: 1px solid var(--night-line);
    }
    .cc-title { font-size: var(--fs-h4); font-weight: 500; }
    .cc-list li { padding: 6px 0; color: rgba(255,255,255,.75); }
    .cc-contact { display: grid; gap: 18px; align-content: start; }
    .cc-contact dd { margin-top: 6px; color: #fff; word-break: break-word; }
    @media (max-width: 799px) { .cc-card { grid-template-columns: 1fr; } }
</style>
