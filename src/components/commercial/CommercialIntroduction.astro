---
import { img } from "../../consts";
import SectionHead from "../ui/SectionHead.astro";
import Split from "../ui/Split.astro";
import Stats from "../ui/Stats.astro";

const image = img("2026/03/Screenshot-2026-03-25-154852.png");
---

<section class="sec">
    <div class="wrap">
        <SectionHead
            index="01"
            label="Our Commercial Philosophy"
            title={["Architecture That", "Works As Hard", "As Your Business."]}
        />

        <Split image={image} alt="Commercial Architecture" ratio="ratio-4-5" caption={{ value: "25+", label: "Years of Commercial Design Excellence" }}>
            <p class="lead" data-reveal>
                Every commercial project begins with understanding
                the way people interact with space. We design
                workplaces, retail environments and institutional
                buildings that improve productivity, strengthen
                identity and remain adaptable for decades.
            </p>
            <p data-reveal>
                By combining thoughtful planning, efficient circulation,
                sustainable design strategies and refined detailing,
                we create buildings that perform exceptionally while
                leaving a lasting architectural impression.
            </p>
            <Stats items={[
                { value: "31+", label: "Commercial Projects" },
                { value: "1.2M+", label: "Sq.ft Delivered" },
                { value: "95%", label: "Repeat Clients" },
            ]} />
        </Split>
    </div>
</section>
