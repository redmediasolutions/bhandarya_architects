---
import projects from "../../content/commercial";
import { getCommercialImages } from "../../lib/commercialImages";
import { Image } from "astro:assets";
import SectionHead from "../ui/SectionHead.astro";
import Meta from "../ui/Meta.astro";
import Btn from "../ui/Btn.astro";
---

<section class="sec">
    <div class="wrap">
        <SectionHead
            index="03"
            label="Portfolio"
            title="Commercial Projects"
            intro="Spaces that combine functionality, flexibility and architectural excellence."
        />

        <div class="cp-list">
            {projects.map((project, index) => {
                const { hero } = getCommercialImages(project.folder);
                const href = `/projects/commercial/${project.slug}`;
                return (
                    <article class:list={["cp-row", index % 2 && "cp-row--rev"]}>
                        <a href={href} class="cp-media media ratio-3-2" data-reveal="mask">
                            {hero ? (
                                <Image src={hero} alt={project.title} width={Math.min(1400, hero.width)} loading="lazy" decoding="async" />
                            ) : (
                                <div class="cp-missing">
                                    <strong>Missing Hero Image</strong>
                                    <span>{project.folder}</span>
                                </div>
                            )}
                        </a>
                        <div class="cp-body" data-reveal style="--d:.08s">
                            <span class="cp-num">{String(index + 1).padStart(2, "0")}</span>
                            <span class="label">{project.subtitle}</span>
                            <h3 class="cp-title"><a href={href}>{project.title}</a></h3>
                            <p>{project.description[0]}</p>
                            <Meta
                                items={[
                                    { label: "Location", value: project.location },
                                    { label: "Area", value: project.area },
                                    {
                                        label: project.status === "Completed" ? "Completed" : "Status",
                                        value: project.status === "Completed" ? project.year : project.status,
                                    },
                                ]}
                            />
                            <div><Btn href={href} variant="arrow">View Project</Btn></div>
                        </div>
                    </article>
                );
            })}
        </div>
    </div>
</section>

<style>
    .cp-list { display: grid; gap: clamp(80px, 10vw, 160px); }
    .cp-row {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: var(--gap);
        row-gap: 32px;
        align-items: start;
    }
    .cp-media { grid-column: 1 / span 7; }
    .cp-body { grid-column: 9 / -1; display: grid; gap: 18px; align-content: start; }
    .cp-row--rev .cp-media { grid-column: 6 / -1; grid-row: 1; }
    .cp-row--rev .cp-body { grid-column: 1 / span 4; grid-row: 1; }

    .cp-num { font-size: var(--fs-label); font-weight: 600; letter-spacing: .12em; color: var(--ink); }
    .cp-title { font-size: clamp(1.7rem, 1.3rem + 1.4vw, 2.6rem); font-weight: 300; letter-spacing: -.025em; }
    .cp-title a:hover { opacity: .6; }
    .cp-body p {
        display: -webkit-box;
        -webkit-line-clamp: 6;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .cp-missing { display: grid; place-content: center; gap: 6px; height: 100%; text-align: center; color: var(--muted); }

    @media (max-width: 1024px) {
        .cp-media, .cp-row--rev .cp-media { grid-column: 1 / span 6; grid-row: 1; }
        .cp-body, .cp-row--rev .cp-body { grid-column: 7 / -1; grid-row: 1; }
    }
    @media (max-width: 799px) {
        .cp-media, .cp-body, .cp-row--rev .cp-media, .cp-row--rev .cp-body { grid-column: 1 / -1; grid-row: auto; }
    }
</style>
