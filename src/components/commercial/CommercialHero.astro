---
import { img } from "../../consts";
import PageHero from "../ui/PageHero.astro";
import ScrollCue from "../ui/ScrollCue.astro";

const hero = img("2026/05/commercial-hero.webp");
---

<PageHero
    label="Commercial Architecture"
    title={["Spaces That Power", "Business Growth."]}
    text="From corporate headquarters and retail environments to institutions and mixed-use developments, we create architecture that elevates brands, enhances productivity and delivers long-term value."
    image={hero}
    actions={[{ text: "Explore Projects", href: "#featured" }]}
    stats={[
        { value: "31+", label: "Commercial Projects" },
        { value: "1.2M+", label: "Sq.ft Delivered" },
        { value: "25+", label: "Years Experience" },
    ]}
>
    <ScrollCue />
</PageHero>
