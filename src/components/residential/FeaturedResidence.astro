---
import projects from "../../content/residential";
import { getResidentialImages } from "../../lib/residentialImages";
import SectionHead from "../ui/SectionHead.astro";
import Featured from "../ui/Featured.astro";

const project = projects.find((p) => p.featured) ?? projects[0];
const { hero } = getResidentialImages(project.folder);
const href = `/projects/residences/${project.slug}`;
---

<section class="sec sec--white" id="featured">
    <div class="wrap">
        <SectionHead index="02" label="Signature Residence" title="Featured Project" />

        <Featured
            href={href}
            image={hero}
            tag="Featured Residence"
            eyebrow={project.category}
            name={project.title}
            paragraphs={[
                "Samudra was envisioned as a tranquil coastal retreat where timeless architecture meets contemporary living. Inspired by colonial design principles, generous verandahs, courtyards and natural materials create a home deeply connected to its landscape.",
            ]}
            meta={[
                { label: "Location", value: project.location },
                { label: "Built Area", value: project.area },
                { label: "Completed", value: project.year },
            ]}
            cta="Explore Project"
        />
    </div>
</section>
