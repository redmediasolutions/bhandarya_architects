---
import { img } from "../../consts";
import SectionHead from "../ui/SectionHead.astro";
import Split from "../ui/Split.astro";

const image = img("2026/05/4-2.webp");

const items = [
    { title: "Site First", text: "Every design responds to its landscape, climate and surroundings." },
    { title: "Light & Ventilation", text: "Natural daylight and airflow become defining elements of every home." },
    { title: "Crafted Details", text: "Every junction, material and proportion is carefully considered." },
];
---

<section class="sec sec--alt approach">
    <div class="wrap">
        <SectionHead index="04" label="Design Approach" title={["Every Home Begins", "With Understanding", "How People Live."]} />

        <Split image={image} alt="Residential Design" caption={{ value: "100%", label: "Custom Designed<br>Homes" }} reverse>
            <p class="lead" data-reveal>
                We believe exceptional residential architecture is
                never about imposing a style. It begins with listening,
                observing and understanding the people who will call
                the space home.
            </p>
            <p data-reveal>
                Every decision—from orientation and spatial planning
                to material selection and natural lighting—is made to
                improve everyday living while ensuring the architecture
                remains timeless.
            </p>
            <dl class="ap-list" data-reveal-stagger=".08">
                {items.map((item) => (
                    <div data-reveal>
                        <dt>{item.title}</dt>
                        <dd>{item.text}</dd>
                    </div>
                ))}
            </dl>
        </Split>
    </div>
</section>

<style>
    .ap-list { border-top: 1px solid var(--line); }
    .ap-list > div {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
        gap: 16px var(--gap);
        padding: 22px 0;
        border-bottom: 1px solid var(--line);
    }
    .ap-list dt { color: var(--ink); font-weight: 500; }
    .ap-list dd { color: var(--ink-2); }
    @media (max-width: 599px) { .ap-list > div { grid-template-columns: 1fr; } }
</style>
