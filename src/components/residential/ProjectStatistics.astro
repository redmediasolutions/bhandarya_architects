---
import SectionHead from "../ui/SectionHead.astro";
import Stats from "../ui/Stats.astro";
---

<section class="sec sec--dark">
    <div class="wrap">
        <SectionHead
            index="05"
            label="By The Numbers"
            title="Designing Homes That Last Generations"
            intro="Every project represents years of collaboration, craftsmanship and thoughtful design."
        />
        <Stats items={[
            { value: "25+", label: "Years Experience" },
            { value: "120+", label: "Residential Projects" },
            { value: "3.5M+", label: "Sq.ft Designed" },
            { value: "98%", label: "Client Satisfaction" },
        ]} />
    </div>
</section>
