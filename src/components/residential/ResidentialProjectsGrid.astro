---
import { getResidentialImages } from "../../lib/residentialImages";
import SectionHead from "../ui/SectionHead.astro";
import ProjectCard from "../ui/ProjectCard.astro";

interface Props {
    projects: any[];
}
const { projects } = Astro.props;
---

<section class="sec">
    <div class="wrap">
        <SectionHead
            index="03"
            label="Residential Portfolio"
            title="Explore Our Homes"
            intro="Every residence is designed around its site, its owners and the way they aspire to live."
        />

        <div class="rp-grid">
            {projects.map((project) => {
                const { hero } = getResidentialImages(project.folder);
                return (
                    <ProjectCard
                        href={`/projects/residences/${project.slug}`}
                        image={hero}
                        title={project.title}
                        eyebrow={project.location}
                        meta={[project.area, project.status === "Under Construction" ? "Under Construction" : project.year]}
                        cta="View Project"
                        ratio="ratio-4-3"
                        width={1100}
                    />
                );
            })}
        </div>
    </div>
</section>

<style>
    .rp-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: clamp(56px, 6vw, 96px) var(--gap);
    }
    .rp-grid :global(.card:nth-child(even)) { margin-top: clamp(0px, 8vw, 128px); }
    @media (max-width: 799px) {
        .rp-grid { grid-template-columns: 1fr; }
        .rp-grid :global(.card:nth-child(even)) { margin-top: 0; }
    }
</style>
