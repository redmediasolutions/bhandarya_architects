---
import { img } from "../../consts";
import SectionHead from "../ui/SectionHead.astro";
import Split from "../ui/Split.astro";
import Rows from "../ui/Rows.astro";

const philosophyImage = img("2026/05/Copy of 06.webp");

const principles = [
    { title: "Human-Centred Planning", text: "Every layout is designed around how families actually live." },
    { title: "Climate Responsive", text: "Light, breeze and landscape become integral elements of every home." },
    { title: "Timeless Craftsmanship", text: "Thoughtful detailing ensures every project remains relevant for decades." },
];
---

<section class="sec">
    <div class="wrap">
        <SectionHead index="01" label="Our Philosophy" title={["Homes Designed Around", "People, Not Trends."]} />

        <Split image={philosophyImage} alt="Residential Architecture" caption={{ value: "25+", label: "Years of<br>Excellence" }}>
            <div data-reveal>
                <p class="lead">
                    Every residence begins with understanding the
                    people who will inhabit it. We believe a home
                    should reflect its owners, embrace its setting,
                    and evolve gracefully through generations.
                </p>
            </div>
            <p data-reveal>
                By carefully balancing natural light, ventilation,
                proportion and materiality, we create timeless
                living environments that are elegant, functional
                and deeply connected to nature.
            </p>
            <Rows items={principles} variant="compact" />
        </Split>
    </div>
</section>
