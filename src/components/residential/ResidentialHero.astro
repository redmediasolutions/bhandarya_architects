---
import { img } from "../../consts";
import PageHero from "../ui/PageHero.astro";
import ScrollCue from "../ui/ScrollCue.astro";

const hero = img("2026/05/Copy-of-02.webp");
---

<PageHero
    label="Residential Architecture"
    title={["Homes Designed", "Around Life,", "Light & Nature."]}
    text="Every residence begins with understanding the family, the landscape and the lifestyle. We create timeless homes where architecture, nature and everyday living exist in perfect harmony."
    image={hero}
    actions={[
        { text: "Explore Projects", href: "#featured" },
        { text: "Start Your Home", href: "/contact" },
    ]}
    stats={[
        { value: "80+", label: "Homes Designed" },
        { value: "25+", label: "Years Experience" },
        { value: "3.5M+", label: "Sq.ft Designed" },
    ]}
>
    <ScrollCue text="Scroll" />
</PageHero>
