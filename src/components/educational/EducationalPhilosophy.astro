---
import { img } from "../../consts";
import SectionHead from "../ui/SectionHead.astro";
import Split from "../ui/Split.astro";
import Rows from "../ui/Rows.astro";

const philosophy = [
  { title: "Learning First", text: "Every space is planned to encourage curiosity, interaction and academic excellence." },
  { title: "Community", text: "Shared spaces strengthen relationships between students, teachers and the wider campus." },
  { title: "Nature", text: "Natural light, ventilation and landscape create healthier learning environments." },
  { title: "Future Ready", text: "Flexible classrooms and adaptable planning allow institutions to evolve over time." }
];

const image = img("2026/05/Copy-of-01.webp");
---

<section class="sec">
    <div class="wrap">
        <SectionHead index="01" label="Our Philosophy" title={["Architecture Is", "The Silent", "Teacher."]} />

        <Split image={image} alt="Educational Campus" reverse>
            <p class="lead" data-reveal>
                Educational architecture goes far beyond
                classrooms. We believe every courtyard,
                corridor, library and gathering space
                should inspire learning, encourage
                collaboration and create a lifelong
                connection between people and place.
            </p>
            <Rows items={philosophy} variant="compact" />
        </Split>
    </div>
</section>
