---
import SectionHead from "../ui/SectionHead.astro";
import Rows from "../ui/Rows.astro";

const principles = [
  { title: "Natural Daylight", number: "01", text: "Abundant daylight improves concentration, wellbeing and overall learning outcomes." },
  { title: "Flexible Spaces", number: "02", text: "Adaptable classrooms and collaborative areas evolve with changing educational needs." },
  { title: "Student Wellbeing", number: "03", text: "Healthy, comfortable environments encourage creativity, focus and social interaction." },
  { title: "Collaboration", number: "04", text: "Open learning environments encourage discussion, teamwork and shared experiences." },
  { title: "Technology", number: "05", text: "Integrated digital infrastructure supports modern teaching and hybrid learning." },
  { title: "Sustainability", number: "06", text: "Energy-efficient design, natural ventilation and landscape reduce environmental impact." }
];
---

<section class="sec">
    <div class="wrap">
        <SectionHead
            index="05"
            label="Learning Environment"
            title={["Spaces That Help", "Students Thrive"]}
            intro="Every educational environment is designed around comfort, curiosity and collaboration, creating places where learning naturally happens."
        />
        <Rows items={principles.map((p) => ({ num: p.number, title: p.title, text: p.text }))} variant="rows" />
    </div>
</section>
