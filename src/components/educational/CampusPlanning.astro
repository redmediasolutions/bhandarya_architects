---
import SectionHead from "../ui/SectionHead.astro";

const zones = [
  { title: "Academic Block", number: "01", text: "Flexible classrooms and collaborative learning environments." },
  { title: "Central Plaza", number: "02", text: "The social heart of the campus encouraging interaction." },
  { title: "Library", number: "03", text: "Knowledge centre with quiet and collaborative study areas." },
  { title: "Innovation Labs", number: "04", text: "Research, experimentation and future-focused learning." },
  { title: "Student Hub", number: "05", text: "Dining, recreation and informal gathering spaces." },
  { title: "Hostels", number: "06", text: "Comfortable residential environments fostering community." }
];
---

<section class="sec sec--dark campus">
    <div class="wrap">
        <SectionHead
            index="04"
            label="Campus Planning"
            title={["Master Planning", "For Better Learning"]}
            intro="Every campus is designed as an interconnected ecosystem where movement, landscape and academic spaces work together."
        />

        <div class="plan" data-reveal-stagger=".08">
            {zones.map((zone, i) => (
                <article class:list={["zone", `zone-${i + 1}`]} data-reveal>
                    <span class="zone-num">{zone.number}</span>
                    <h3>{zone.title}</h3>
                    <p>{zone.text}</p>
                </article>
            ))}
            <span class="plan-axis plan-axis--h" aria-hidden="true"></span>
            <span class="plan-axis plan-axis--v" aria-hidden="true"></span>
        </div>
    </div>
</section>

<style>
    .plan {
        position: relative;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        border: 1px solid var(--night-line);
    }
    .zone {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 12px;
        min-height: clamp(220px, 22vw, 300px);
        padding: clamp(24px, 3vw, 40px);
        border-right: 1px solid var(--night-line);
        border-bottom: 1px solid var(--night-line);
        transition: background .5s ease;
    }
    .zone:nth-child(3n) { border-right: 0; }
    .zone:nth-child(n + 4) { border-bottom: 0; }
    .zone:hover { background: rgba(255,255,255,.03); }
    .zone-num {
        display: grid;
        place-items: center;
        width: 40px;
        height: 40px;
        margin-bottom: auto;
        border: 1px solid rgba(255,255,255,.4);
        border-radius: 50%;
        font-size: var(--fs-label);
        font-weight: 600;
        letter-spacing: .08em;
        color: #fff;
    }
    .zone h3 { margin-top: 32px; font-size: var(--fs-h4); font-weight: 500; }
    .zone p { max-width: 32ch; font-size: var(--fs-small); color: rgba(255,255,255,.62); }

    /* central circulation spine — a nod to the plan drawing */
    .zone-2::after {
        content: "";
        position: absolute;
        left: 50%;
        bottom: -7px;
        width: 13px;
        height: 13px;
        border: 1px solid #fff;
        border-radius: 50%;
        background: var(--night);
        transform: translateX(-50%);
        z-index: 1;
    }
    .plan-axis { display: none; }

    @media (max-width: 899px) {
        .plan { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .zone { border-right: 1px solid var(--night-line) !important; border-bottom: 1px solid var(--night-line) !important; }
        .zone:nth-child(2n) { border-right: 0 !important; }
        .zone:nth-child(n + 5) { border-bottom: 0 !important; }
        .zone-2::after { display: none; }
    }
    @media (max-width: 499px) {
        .plan { grid-template-columns: 1fr; }
        .zone { border-right: 0 !important; min-height: 0; }
        .zone:nth-child(5) { border-bottom: 1px solid var(--night-line) !important; }
    }
</style>
