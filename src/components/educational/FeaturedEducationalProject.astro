---
import projects from "../../content/educational";
import { getEducationalImages } from "../../lib/educationalImages";
import SectionHead from "../ui/SectionHead.astro";
import Featured from "../ui/Featured.astro";

const project = projects.find((p) => p.featured) ?? projects[0];
const { hero } = getEducationalImages(project.folder);
const href = `/projects/educational/${project.slug}`;
---

<section class="sec" id="projects">
    <div class="wrap">
        <SectionHead index="03" label="Featured Campus" title="Featured Project" />

        <Featured
            href={href}
            image={hero}
            tag="Featured Project"
            eyebrow={project.subtitle}
            name={project.title}
            paragraphs={project.description.slice(0, 2)}
            meta={[
                { label: "Project Type", value: project.subtitle },
                { label: "Location", value: project.location },
                { label: "Area", value: project.area },
                {
                    label: project.status === "Completed" ? "Completed" : "Status",
                    value: project.status === "Completed" ? project.year : project.status,
                },
            ]}
            cta="Explore Project"
            reverse
        />
    </div>
</section>
