---
import SectionHead from "../ui/SectionHead.astro";
import Rows from "../ui/Rows.astro";

const types = [
  { number: "01", title: "Schools", text: "Learning environments designed to encourage creativity, safety and holistic development from early education through higher secondary." },
  { number: "02", title: "Colleges", text: "Academic campuses that balance flexible learning spaces, student interaction and long-term institutional growth." },
  { number: "03", title: "Universities", text: "Large-scale master planned campuses integrating academic blocks, research centres, hostels and public spaces." },
  { number: "04", title: "Libraries", text: "Quiet, inspiring knowledge centres designed for concentration, collaboration and digital learning." },
  { number: "05", title: "Research Centres", text: "Innovation-driven environments that support laboratories, collaborative workspaces and future technologies." },
  { number: "06", title: "Training Institutes", text: "Skill development campuses with flexible classrooms, workshops and industry-focused learning environments." }
];
---

<section class="sec sec--white">
    <div class="wrap">
        <SectionHead
            index="02"
            label="Educational Expertise"
            title={["Spaces For Every", "Learning Journey"]}
            intro="From neighbourhood schools to university campuses, we create environments that inspire learning, collaboration and innovation."
        />
        <Rows items={types.map((t) => ({ num: t.number, title: t.title, text: t.text }))} variant="grid" cols={3} />
    </div>
</section>
