---
import { img } from "../../consts";
import PageHero from "../ui/PageHero.astro";
import ScrollCue from "../ui/ScrollCue.astro";

const heroImage = img("2026/05/educational-hero.webp");
---

<PageHero
    label="Educational Architecture"
    title={["Designing", "Inspiring", "Learning Spaces"]}
    text="We create schools, colleges and educational campuses that nurture curiosity, encourage collaboration and provide environments where students thrive for generations."
    image={heroImage}
    actions={[
        { text: "Discuss Your Project", href: "/contact" },
        { text: "Explore Projects", href: "#projects" },
    ]}
>
    <ScrollCue />
</PageHero>
