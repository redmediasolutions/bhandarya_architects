---
import SectionHead from "../ui/SectionHead.astro";
import Rows from "../ui/Rows.astro";

const highlights = [
  { title: "Bespoke Design", text: "Every interior is individually designed around your lifestyle, aspirations and architectural context." },
  { title: "Material Expertise", text: "Natural stone, timber, metals and handcrafted finishes are carefully curated for timeless elegance." },
  { title: "Lighting Design", text: "Layered lighting enhances mood, texture and functionality while creating memorable interiors." },
  { title: "Custom Furniture", text: "Furniture and joinery are designed specifically for each project, ensuring perfect proportion and fit." },
  { title: "Turnkey Coordination", text: "We collaborate with contractors, craftsmen and vendors to deliver interiors exactly as envisioned." },
  { title: "Timeless Aesthetics", text: "Our interiors are designed to remain relevant for decades rather than following temporary trends." }
];
---

<section class="sec">
    <div class="wrap">
        <SectionHead
            index="05"
            label="Why Choose Us"
            title={["Crafted With", "Precision &", "Purpose."]}
            intro="Every project combines thoughtful planning, premium materials and exceptional craftsmanship to create interiors that feel elegant, functional and enduring."
        />
        <Rows items={highlights} variant="rows" />
    </div>
</section>
