---
import SectionHead from "../ui/SectionHead.astro";
import Rows from "../ui/Rows.astro";

const process = [
  { step: "01", title: "Discovery", text: "Understanding your lifestyle, aspirations and how you want your spaces to feel." },
  { step: "02", title: "Space Planning", text: "Organising circulation, furniture layouts and functionality before aesthetics." },
  { step: "03", title: "Materials", text: "Selecting finishes, textures, colours and lighting to create a timeless palette." },
  { step: "04", title: "Detail Design", text: "Custom furniture, joinery, lighting and architectural detailing are refined." },
  { step: "05", title: "Execution", text: "Working closely with craftsmen to ensure every detail is built exactly as envisioned." }
];
---

<section class="sec sec--dark">
    <div class="wrap">
        <SectionHead
            index="04"
            label="Our Process"
            title={["From Concept", "To Completion"]}
            intro="Every interior follows a carefully considered journey where design, craftsmanship and execution work together seamlessly."
        />
        <Rows items={process.map((p) => ({ num: p.step, title: p.title, text: p.text }))} variant="grid" cols={5} />
    </div>
</section>
