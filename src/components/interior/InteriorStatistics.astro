---
import SectionHead from "../ui/SectionHead.astro";
import Stats from "../ui/Stats.astro";

const metrics = [
  { value: "85+", label: "Interior Projects", text: "Luxury homes, hospitality and commercial interiors." },
  { value: "2.1M+", label: "Sq.ft Designed", text: "Thoughtfully planned interior environments." },
  { value: "25+", label: "Years Experience", text: "Creating timeless interior spaces." },
  { value: "450+", label: "Custom Elements", text: "Furniture, joinery and bespoke details." }
];
---

<section class="sec sec--white">
    <div class="wrap">
        <SectionHead
            index="06"
            label="Interior Excellence"
            title={["Every Detail", "Counts"]}
            intro="Behind every interior lies countless hours of planning, craftsmanship and thoughtful detailing."
        />
        <Stats items={metrics} />
    </div>
</section>
