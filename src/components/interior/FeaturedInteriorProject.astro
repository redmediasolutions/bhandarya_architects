---
import projects from "../../content/interiors";
import { getInteriorImages } from "../../lib/interiorImages";
import SectionHead from "../ui/SectionHead.astro";
import Featured from "../ui/Featured.astro";

const project = projects.find((p) => p.featured) ?? projects[0];
const { hero } = getInteriorImages(project.folder);
const href = `/projects/interiors/${project.slug}`;
---

<section class="sec sec--white" id="featured">
    <div class="wrap">
        <SectionHead index="02" label="Signature Interior" title="Featured Project" />

        <Featured
            href={href}
            image={hero}
            eyebrow={project.subtitle}
            name={project.title}
            paragraphs={[
                "Designed as a seamless extension of the architecture, the interiors celebrate natural materials, handcrafted detailing and soft, ambient lighting to create a timeless living experience.",
            ]}
            chips={project.highlights.slice(0, 4)}
            meta={[
                { label: "Location", value: project.location },
                { label: "Area", value: project.area },
                {
                    label: project.status === "Completed" ? "Completed" : "Status",
                    value: project.status === "Completed" ? project.year : project.status,
                },
            ]}
            cta="View Project"
        />
    </div>
</section>
