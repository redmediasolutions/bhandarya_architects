---
import projects from "../../content/interiors";
import { getInteriorImages } from "../../lib/interiorImages";
import SectionHead from "../ui/SectionHead.astro";
import ProjectCard from "../ui/ProjectCard.astro";

const interiorProjects = projects.map((project, index) => ({
    ...project,
    image: getInteriorImages(project.folder).hero,
    href: `/projects/interiors/${project.slug}`,
    featured: index === 0
}));
---

<section class="sec">
    <div class="wrap">
        <SectionHead
            index="03"
            label="Portfolio"
            title="Interior Projects"
            intro="A collection of timeless interiors crafted around materials, light, detail and everyday living."
        />

        <div class="ip-grid">
            {interiorProjects.map((project) => (
                <ProjectCard
                    href={project.href}
                    image={project.image}
                    title={project.title}
                    eyebrow={project.subtitle}
                    meta={[project.area]}
                    cta="View Project"
                    ratio={project.featured ? "ratio-16-9" : "ratio-4-5"}
                    width={project.featured ? 1800 : 900}
                    class={project.featured ? "ip-lead" : undefined}
                />
            ))}
        </div>
    </div>
</section>

<style>
    .ip-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: clamp(56px, 6vw, 96px) var(--gap);
    }
    .ip-grid :global(.ip-lead) { grid-column: 1 / -1; }
    @media (max-width: 1024px) { .ip-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 599px) { .ip-grid { grid-template-columns: 1fr; } }
</style>
