---
import SectionHead from "../ui/SectionHead.astro";
import Rows from "../ui/Rows.astro";

const pillars = [
  { number: "01", title: "Materiality", text: "Natural stone, warm timber, textured finishes and carefully selected materials define spaces that age gracefully." },
  { number: "02", title: "Natural Light", text: "Light is treated as a design material, shaping mood, enhancing textures and bringing every interior to life." },
  { number: "03", title: "Craftsmanship", text: "Every detail is refined through bespoke joinery, custom furniture and precision execution." }
];
---

<section class="sec intro">
    <div class="intro-word" aria-hidden="true">INTERIORS</div>
    <div class="wrap">
        <SectionHead index="01" label="Our Philosophy" title={["Interiors Designed", "Around The Way", "You Live."]} />

        <div class="ii-grid">
            <div class="ii-text" data-reveal>
                <p class="lead">
                    Interior design is more than selecting finishes or
                    arranging furniture. It is about creating spaces that
                    feel comfortable, timeless and deeply personal.
                    Every project balances architecture, light,
                    proportion and craftsmanship to create interiors
                    that enrich everyday life.
                </p>
                <p>
                    From luxury residences to hospitality and commercial
                    environments, we believe every interior should tell
                    a unique story while remaining elegant for decades.
                </p>
            </div>
        </div>

        <Rows items={pillars.map((p) => ({ num: p.number, title: p.title, text: p.text }))} variant="grid" cols={3} />
    </div>
</section>

<style>
    .intro { overflow: hidden; }
    .intro-word {
        position: absolute;
        top: clamp(24px, 3vw, 48px);
        right: calc(var(--gutter) * -0.2);
        font-size: clamp(4.5rem, 14vw, 13rem);
        font-weight: 200;
        letter-spacing: -.05em;
        line-height: .8;
        color: transparent;
        -webkit-text-stroke: 1px rgba(21,21,21,.08);
        pointer-events: none;
        user-select: none;
    }
    .ii-grid {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: var(--gap);
        margin-bottom: clamp(64px, 8vw, 120px);
    }
    .ii-text { grid-column: 5 / span 7; display: grid; gap: 20px; }
    .ii-text p { max-width: 60ch; }
    @media (max-width: 899px) { .ii-text { grid-column: 1 / -1; } }
</style>
