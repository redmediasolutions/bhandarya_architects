---
const year = new Date().getFullYear();

const quickLinks = [
  { name: "Home", href: "/" },
  { name: "About", href: "/about" },
  { name: "Projects", href: "/projects" },
  { name: "Services", href: "/#services" },
  { name: "Contact", href: "/contact" },
];

const services = [
  "Architecture",
  "Interior Design",
  "Master Planning",
  "Landscape Design",
  "Project Management",
];

const stats = [
  { number: "30+", label: "Years" },
  { number: "500+", label: "Projects" },
  { number: "1995", label: "Established" },
];

const social = [
  { name: "Instagram", href: "#" },
  { name: "Facebook", href: "#" },
  { name: "LinkedIn", href: "#" },
];
---

<footer class="site-footer on-dark">
    <div class="wrap">

        <div class="ft-top">
            <div class="ft-brand">
                <a href="/" class="ft-logo" aria-label="Bhandary Architects">
                    <span class="ft-logo-name">Bhandary</span>
                    <span class="ft-logo-sub">Architects</span>
                </a>
                <p class="ft-description">
                    Designing timeless residential, commercial and hospitality spaces
                    through thoughtful architecture, refined interiors and sustainable
                    planning.
                </p>
            </div>

            <dl class="ft-stats">
                {stats.map((s) => (
                    <div>
                        <dd>{s.number}</dd>
                        <dt>{s.label}</dt>
                    </div>
                ))}
            </dl>
        </div>

        <div class="ft-cols">
            <div class="ft-col">
                <h4 class="ft-head">Quick Links</h4>
                <ul>
                    {quickLinks.map((link) => (
                        <li><a href={link.href}>{link.name}</a></li>
                    ))}
                </ul>
            </div>

            <div class="ft-col">
                <h4 class="ft-head">Services</h4>
                <ul>
                    {services.map((service) => <li>{service}</li>)}
                </ul>
            </div>

            <div class="ft-col ft-contact">
                <h4 class="ft-head">Contact</h4>
                <ul>
                    <li>
                        <span class="ft-label">Studio</span>
                        <span>
                            No.1006, Felicity Block 2,
                            Near SBI NRI Branch, <br />
                            2-Bejai New Road, Bejai,
                            Mangalore-575004, Karnataka
                        </span>
                    </li>
                    <li>
                        <span class="ft-label">Email</span>
                        <a href="mailto:contact@bhandaryarchitects.com">contact@bhandaryarchitects.com</a>
                    </li>
                    <li>
                        <span class="ft-label">Phone</span>
                        <a href="tel:+919876543210">+91 98765 43210</a>
                    </li>
                </ul>
            </div>

            <div class="ft-col ft-social">
                <ul>
                    {social.map((s) => (
                        <li><a href={s.href} aria-label={s.name}>{s.name}</a></li>
                    ))}
                </ul>
            </div>
        </div>

        <div class="ft-bottom">
            <div class="ft-copy">
                <span>© {year}</span>
                <span>Bhandary Architects</span>
            </div>
            <small class="ft-tag">Architecture • Interiors • Planning</small>
            <div class="ft-credit">
                Developed by
                <a href="https://redmediasolutions.in" target="_blank" rel="noopener noreferrer">Red Media</a>
            </div>
        </div>

    </div>
</footer>

<style>
    .site-footer {
        background: var(--night);
        color: rgba(255, 255, 255, .62);
        padding-top: clamp(80px, 9vw, 140px);
        border-top: 1px solid var(--night-line);
        font-size: var(--fs-small);
    }
    .site-footer a { transition: color .3s ease; }
    .site-footer a:hover { color: #fff; }

    .ft-top {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: var(--gap);
        row-gap: 48px;
        align-items: end;
        padding-bottom: clamp(56px, 6vw, 88px);
    }
    .ft-brand { grid-column: 1 / span 6; }
    .ft-logo { display: inline-flex; align-items: baseline; gap: 10px; color: #fff; line-height: 1; }
    .ft-logo-name { font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.4rem); font-weight: 700; text-transform: uppercase; letter-spacing: .01em; }
    .ft-logo-sub { font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.4rem); font-weight: 200; text-transform: uppercase; letter-spacing: .01em; }
    .ft-description { margin-top: 28px; max-width: 44ch; font-size: var(--fs-body); line-height: 1.7; }

    .ft-stats {
        grid-column: 8 / -1;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        border-top: 1px solid var(--night-line);
    }
    .ft-stats > div { display: flex; flex-direction: column; padding-top: 20px; }
    .ft-stats > div + div { padding-left: 20px; border-left: 1px solid var(--night-line); }
    .ft-stats dd { color: #fff; font-size: clamp(1.8rem, 1.4rem + 1.2vw, 2.6rem); font-weight: 200; letter-spacing: -.03em; line-height: 1; }
    .ft-stats dt { order: 2; margin-top: 10px; font-size: var(--fs-label); font-weight: 600; letter-spacing: .2em; text-transform: uppercase; color: rgba(255,255,255,.45); }

    .ft-cols {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: var(--gap);
        row-gap: 48px;
        padding-block: 48px clamp(56px, 6vw, 96px);
        border-top: 1px solid var(--night-line);
    }
    .ft-col:nth-child(1) { grid-column: 1 / span 2; }
    .ft-col:nth-child(2) { grid-column: 3 / span 3; }
    .ft-contact { grid-column: 6 / span 4; }
    .ft-social { grid-column: 11 / -1; }

    .ft-head {
        margin-bottom: 22px;
        color: rgba(255,255,255,.45);
        font-size: var(--fs-label);
        font-weight: 600;
        letter-spacing: .2em;
        text-transform: uppercase;
    }
    .ft-col ul { display: grid; gap: 10px; }
    .ft-col li { color: rgba(255,255,255,.78); font-size: var(--fs-body); line-height: 1.5; }
    .ft-contact ul { gap: 20px; }
    .ft-contact li { display: grid; gap: 4px; }
    .ft-label { font-size: var(--fs-label); font-weight: 600; letter-spacing: .2em; text-transform: uppercase; color: rgba(255,255,255,.4); }
    .ft-social ul { padding-top: 38px; }

    .ft-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px 32px;
        flex-wrap: wrap;
        padding-block: 28px;
        border-top: 1px solid var(--night-line);
        font-size: var(--fs-small);
    }
    .ft-copy { display: flex; gap: 8px; }
    .ft-tag { font-size: var(--fs-label); font-weight: 600; letter-spacing: .24em; text-transform: uppercase; color: rgba(255,255,255,.4); }
    .ft-credit a { color: #fff; }

    @media (max-width: 1024px) {
        .ft-brand, .ft-stats { grid-column: 1 / -1; }
        .ft-col:nth-child(1) { grid-column: 1 / span 4; }
        .ft-col:nth-child(2) { grid-column: 5 / span 4; }
        .ft-contact { grid-column: 1 / span 8; }
        .ft-social { grid-column: 9 / -1; }
        .ft-social ul { padding-top: 0; }
    }
    @media (max-width: 599px) {
        .ft-col:nth-child(1) { grid-column: 1 / span 6; }
        .ft-col:nth-child(2) { grid-column: 7 / -1; }
        .ft-contact, .ft-social { grid-column: 1 / -1; }
        .ft-social ul { display: flex; gap: 24px; }
        .ft-bottom { flex-direction: column; align-items: flex-start; }
    }
</style>
