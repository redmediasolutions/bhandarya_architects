---
interface Props { text?: string }
const { text } = Astro.props;
---
<div class="scue" aria-hidden="true">
    {text && <span>{text}</span>}
    <i></i>
</div>

<style>
    .scue {
        position: absolute;
        right: var(--gutter);
        top: 50%;
        display: none;
        flex-direction: column;
        align-items: center;
        gap: 14px;
        writing-mode: vertical-rl;
        font-size: var(--fs-label);
        font-weight: 600;
        letter-spacing: .24em;
        text-transform: uppercase;
        color: rgba(255,255,255,.55);
        transform: translateY(-50%);
    }
    .scue i { position: relative; width: 1px; height: 64px; background: rgba(255,255,255,.25); overflow: hidden; }
    .scue i::after {
        content: ""; position: absolute; left: 0; top: -40%; width: 1px; height: 40%; background: #fff;
        animation: scue 2.4s var(--ease) infinite;
    }
    @keyframes scue { to { top: 100%; } }
    @media (min-width: 1280px) { .scue { display: flex; } }
</style>
