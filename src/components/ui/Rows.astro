---
/**
 * Numbered list of principles / steps / features.
 *  - "rows": full-width hairline rows (number | title | text)
 *  - "grid": 2–3 column grid of items with a top rule
 */
interface Item {
    num?: string;
    title: string;
    text: string;
}
interface Props {
    items: Item[];
    variant?: "rows" | "grid" | "compact";
    cols?: 2 | 3 | 4 | 5;
    numbered?: boolean;
    class?: string;
}
const { items, variant = "rows", cols = 3, numbered = true, class: cls } = Astro.props;
const pad = (n: number) => String(n).padStart(2, "0");
---
<ol class:list={["rows", `rows--${variant}`, cls]} style={`--cols:${cols}`} data-reveal-stagger=".07">
    {items.map((item, i) => (
        <li class="row" data-reveal>
            {numbered && <span class="row-num">{item.num ?? pad(i + 1)}</span>}
            <h3 class="row-title">{item.title}</h3>
            <p class="row-text">{item.text}</p>
        </li>
    ))}
</ol>

<style>
    .row-num {
        font-size: var(--fs-label);
        font-weight: 600;
        letter-spacing: .12em;
        color: var(--muted);
        font-variant-numeric: tabular-nums;
    }
    .row-title { font-size: var(--fs-h4); font-weight: 500; letter-spacing: -0.01em; }
    .row-text { color: var(--ink-2); max-width: 46ch; }
    :global(.sec--dark) .row-text { color: rgba(255,255,255,.66); }
    :global(.sec--dark) .row-num { color: rgba(255,255,255,.45); }

    /* rows */
    .rows--rows { border-top: 1px solid var(--line); }
    .rows--rows .row {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: var(--gap);
        align-items: baseline;
        padding: 30px 0;
        border-bottom: 1px solid var(--line);
    }
    .rows--rows .row-num { grid-column: 1 / span 1; }
    .rows--rows .row-title { grid-column: 2 / span 4; }
    .rows--rows .row-text { grid-column: 7 / -1; }

    /* compact (used inside a narrow column) */
    .rows--compact { border-top: 1px solid var(--line); }
    .rows--compact .row {
        display: grid;
        grid-template-columns: 56px 1fr;
        column-gap: 16px;
        row-gap: 6px;
        padding: 22px 0;
        border-bottom: 1px solid var(--line);
    }
    .rows--compact .row-num { grid-row: 1 / span 2; padding-top: .35em; }
    .rows--compact .row-text { font-size: var(--fs-small); color: var(--muted); }

    /* grid */
    .rows--grid {
        display: grid;
        grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
        column-gap: var(--gap);
        row-gap: clamp(40px, 5vw, 72px);
    }
    .rows--grid .row {
        display: flex;
        flex-direction: column;
        gap: 14px;
        padding-top: 22px;
        border-top: 1px solid var(--line);
    }
    .rows--grid .row-num { margin-bottom: clamp(16px, 3vw, 40px); }
    :global(.sec--dark) .rows--grid .row,
    :global(.sec--dark) .rows--rows,
    :global(.sec--dark) .rows--rows .row { border-color: var(--night-line); }

    @media (max-width: 1024px) {
        .rows--grid { grid-template-columns: repeat(min(var(--cols), 2), minmax(0, 1fr)); }
    }
    @media (max-width: 899px) {
        .rows--rows .row { grid-template-columns: 48px 1fr; row-gap: 8px; }
        .rows--rows .row-num { grid-column: 1; grid-row: 1 / span 2; }
        .rows--rows .row-title,
        .rows--rows .row-text { grid-column: 2; }
    }
    @media (max-width: 599px) {
        .rows--grid { grid-template-columns: 1fr; }
    }
</style>
