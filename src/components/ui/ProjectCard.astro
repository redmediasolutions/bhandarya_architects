---
/**
 * Image-first project card. Caption sits beneath the photograph
 * (never over it) — the way architects present their own work.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
    href: string;
    image?: ImageMetadata | string;
    title: string;
    eyebrow?: string;
    meta?: (string | undefined)[];
    cta?: string;
    ratio?: string;
    width?: number;
    eager?: boolean;
    index?: string;
    parallax?: boolean;
    class?: string;
}

const {
    href,
    image,
    title,
    eyebrow,
    meta = [],
    cta,
    ratio = "ratio-4-3",
    width = 1200,
    eager = false,
    index,
    parallax = false,
    class: cls,
} = Astro.props;

const metaItems = meta.filter(Boolean) as string[];
---
<a href={href} class:list={["card", parallax && "card--px", cls]} data-reveal={parallax ? undefined : ""}>
    <div class:list={["media", ratio]} data-reveal={parallax ? "mask" : undefined}>
        <div class="card-inner">
            {image && (typeof image === "string" ? (
                <img src={image} alt={title} loading={eager ? "eager" : "lazy"} decoding="async" data-parallax={parallax ? "0.06" : undefined} />
            ) : (
                <Image src={image} alt={title} width={Math.min(width, image.width)} loading={eager ? "eager" : "lazy"} decoding="async" data-parallax={parallax ? "0.06" : undefined} />
            ))}
        </div>
    </div>
    <div class="card-cap">
        <div class="card-txt">
            {(eyebrow || index) && (
                <span class="label card-eyebrow">
                    {index && <span class="card-index">{index}</span>}
                    {eyebrow}
                </span>
            )}
            <h3 class="card-title">{title}</h3>
            {metaItems.length > 0 && (
                <p class="card-meta">{metaItems.map((m, i) => <span>{m}</span>)}</p>
            )}
        </div>
        {cta ? (
            <span class="arrow-link card-cta"><span>{cta}</span><span class="ar" aria-hidden="true"></span></span>
        ) : (
            <span class="card-arrow" aria-hidden="true"><span class="ar"></span></span>
        )}
    </div>
</a>

<style>
    .card { display: block; color: var(--ink); }
    .card-inner { width: 100%; height: 100%; overflow: hidden; }
    .card-inner :global(img) { width: 100%; height: 100%; object-fit: cover; }
    .card--px .media :global(img) { transition: none; }
    .card--px .card-inner { transition: transform 1.4s var(--ease), clip-path 1.5s cubic-bezier(.77,0,.18,1); }
    .card--px:hover .card-inner { transform: scale(1.04); }
    .card-index { color: var(--ink); margin-right: 14px; letter-spacing: .1em; }
    .card--px .card-cap { opacity: 0; transform: translateY(14px); transition: opacity 1s var(--ease) .25s, transform 1s var(--ease) .25s; }
    .card--px .media.is-in + .card-cap, :global(html:not(.js)) .card--px .card-cap { opacity: 1; transform: none; }
    .card-cap {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        padding-top: 18px;
    }
    .card-eyebrow { display: block; margin-bottom: 8px; }
    .card-title { font-size: clamp(1.1rem, 1rem + .45vw, 1.45rem); font-weight: 400; letter-spacing: -0.015em; line-height: 1.25; }
    .card-meta { margin-top: 6px; font-size: var(--fs-small); color: var(--muted); display: flex; flex-wrap: wrap; gap: 4px 0; }
    .card-meta span + span::before { content: "·"; margin: 0 .55em; }
    .card-cta { flex: none; margin-top: 4px; }
    .card-arrow { flex: none; padding-top: .7em; color: var(--ink); opacity: 0; transform: translateX(-8px); transition: opacity var(--transition), transform var(--transition); }
    .card-arrow .ar { position: relative; display: block; width: 28px; height: 1px; background: currentColor; }
    .card-arrow .ar::after {
        content: ""; position: absolute; right: 0; top: -3px; width: 7px; height: 7px;
        border-top: 1px solid currentColor; border-right: 1px solid currentColor; transform: rotate(45deg);
    }
    .card:hover .card-arrow { opacity: 1; transform: none; }
    @media (hover: none) { .card-arrow { opacity: 1; transform: none; } }
</style>
