---
/**
 * "Featured project" spread: large photograph with a quiet
 * information column (category, name, copy, facts, link).
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Meta from "./Meta.astro";
import Btn from "./Btn.astro";

interface Props {
    href: string;
    image: ImageMetadata;
    imageHref?: string;
    tag?: string;
    eyebrow?: string;
    name: string;
    paragraphs?: string[];
    meta?: { label: string; value: string | undefined }[];
    chips?: string[];
    cta: string;
    reverse?: boolean;
}
const { href, image, imageHref = href, tag, eyebrow, name, paragraphs = [], meta = [], chips = [], cta, reverse = false } = Astro.props;
---
<div class:list={["feat", reverse && "feat--reverse"]}>
    <a href={imageHref} class="feat-media media" data-reveal="mask">
        <Image src={image} alt={name} width={Math.min(1800, image.width)} loading="lazy" decoding="async" />
        {tag && <span class="feat-tag label">{tag}</span>}
    </a>

    <div class="feat-body" data-reveal style="--d:.1s">
        {eyebrow && <span class="label">{eyebrow}</span>}
        <h3 class="feat-name">{name}</h3>
        {paragraphs.map((p) => <p>{p}</p>)}
        {chips.length > 0 && (
            <ul class="feat-chips">{chips.map((c) => <li>{c}</li>)}</ul>
        )}
        {meta.length > 0 && <Meta items={meta} layout="list" />}
        <div><Btn href={href} variant="arrow">{cta}</Btn></div>
    </div>
</div>

<style>
    .feat {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: var(--gap);
        row-gap: 48px;
        align-items: start;
    }
    .feat-media { grid-column: 1 / span 7; aspect-ratio: 4 / 5; position: sticky; top: calc(var(--header-h) + 24px); }
    .feat-body { grid-column: 9 / -1; display: grid; gap: 22px; align-content: start; }
    .feat--reverse .feat-media { grid-column: 6 / -1; grid-row: 1; }
    .feat--reverse .feat-body { grid-column: 1 / span 4; grid-row: 1; }

    .feat-tag {
        position: absolute;
        left: 20px;
        top: 20px;
        padding: 8px 12px;
        background: var(--paper);
        color: var(--ink);
        clip-path: none !important;
    }
    .feat-name { font-size: clamp(2rem, 1.5rem + 2vw, 3.25rem); font-weight: 300; letter-spacing: -.03em; }
    .feat-body p { font-size: var(--fs-body); }
    .feat-body :global(.meta) { margin-block: 8px; }

    .feat-chips { display: flex; flex-wrap: wrap; gap: 8px; }
    .feat-chips li {
        padding: 7px 12px;
        border: 1px solid var(--line-strong);
        font-size: var(--fs-small);
        color: var(--ink-2);
    }

    @media (max-width: 1024px) {
        .feat-media { grid-column: 1 / span 6; }
        .feat-body { grid-column: 7 / -1; }
        .feat--reverse .feat-media { grid-column: 7 / -1; }
        .feat--reverse .feat-body { grid-column: 1 / span 6; }
    }
    @media (max-width: 899px) {
        .feat-media, .feat-body,
        .feat--reverse .feat-media, .feat--reverse .feat-body { grid-column: 1 / -1; grid-row: auto; }
        .feat-media { position: relative; top: 0; aspect-ratio: 4 / 3; }
    }
</style>
