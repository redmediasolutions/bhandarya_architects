---
import "@fontsource-variable/manrope";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;

  image?: string;
  canonical?: string;
  keywords?: string;
  type?: "website" | "article";
  noindex?: boolean;
}

const {
  title,
  description,
  image = "/images/og-image.jpg",
  canonical = Astro.url.href,
  keywords = "Bhandary Architects, Architects in Mangalore, Architecture, Interior Design, Commercial Architecture, Residential Architecture, Master Planning",
  type = "website",
  noindex = false,
} = Astro.props;

const siteName = "Bhandary Architects";
const siteUrl = Astro.site?.toString() ?? "https://bhandaryarchitects.com";
const pageTitle = `${title} | ${siteName}`;

const imageUrl = image.startsWith("http")
  ? image
  : new URL(image, siteUrl).toString();
---

<!doctype html>

<html lang="en">

<head>

    <script is:inline>document.documentElement.classList.add("js");</script>

    <!-- Basic -->

    <meta charset="UTF-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1"
    />

    <title>{pageTitle}</title>

    <meta
        name="description"
        content={description}
    />

    <meta
        name="keywords"
        content={keywords}
    />

    <meta
        name="author"
        content="Bhandary Architects"
    />

    <meta
        name="robots"
        content={noindex ? "noindex,nofollow" : "index,follow"}
    />

    <meta
        name="theme-color"
        content="#f5f3ef"
    />

    <link
        rel="canonical"
        href={canonical}
    />

    <!-- Open Graph -->

    <meta property="og:type" content={type} />

    <meta property="og:title" content={pageTitle} />

    <meta
        property="og:description"
        content={description}
    />

    <meta
        property="og:url"
        content={canonical}
    />

    <meta
        property="og:site_name"
        content={siteName}
    />

    <meta
        property="og:image"
        content={imageUrl}
    />

    <!-- Twitter -->

    <meta
        name="twitter:card"
        content="summary_large_image"
    />

    <meta
        name="twitter:title"
        content={pageTitle}
    />

    <meta
        name="twitter:description"
        content={description}
    />

    <meta
        name="twitter:image"
        content={imageUrl}
    />

    <!-- Favicons -->

    <link
        rel="icon"
        href="/favicon.ico"
    />

    <link
        rel="apple-touch-icon"
        href="/apple-touch-icon.png"
    />

    <!-- Structured Data -->

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Architect",
      name: "Bhandary Architects",
      url: siteUrl,
      image: imageUrl,
      description,
      telephone: "+91-XXXXXXXXXX",
      email: "hello@bhandaryarchitects.com",
      address: {
        "@type": "PostalAddress",
        addressLocality: "Mangalore",
        addressRegion: "Karnataka",
        addressCountry: "IN"
      }
    })} />

</head>

<body>

    <slot />

    <script>
        import "../scripts/reveal";
    </script>

</body>

</html>
